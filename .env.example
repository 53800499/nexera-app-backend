# Back-End Environment Template
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@postgres:5432/nexera"
DIRECT_URL="postgresql://user:password@postgres:5432/nexera"

# JWT
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-here-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Application
NODE_ENV="development"
PORT=3008
CORS_ORIGIN="http://localhost:3000"
API_PREFIX="api"

# Email (quotations)
MAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Password Reset
FRONT_APP_URL="http://localhost:3000"
PASSWORD_RESET_EXPIRATION_MINUTES=60
DEFAULT_USER_PASSWORD="password1234"

# Docker Compose
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="nexera"
DB_PORT=5431
