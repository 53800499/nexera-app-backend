# Database
DATABASE_URL="postgresql://user:password@localhost:5432/femax"

# JWT
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-here-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Application
NODE_ENV="development"
PORT=3008
# Front local (CORS) — plusieurs origines séparées par des virgules
CORS_ORIGIN="http://localhost:3000"
# Préfixe global des routes API (ex. /api/auth/login)
API_PREFIX="api"

# Swagger UI: http://localhost:3000/api/docs (avec API_PREFIX=api)

# Email (quotations)
MAIL_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Mot de passe oublié
FRONT_APP_URL="http://localhost:3000"
PASSWORD_RESET_EXPIRATION_MINUTES=60
DEFAULT_USER_PASSWORD="password1234"
