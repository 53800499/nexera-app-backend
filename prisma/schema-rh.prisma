// ----------------------------------------------------
// GROUPE A : RÉFÉRENTIEL INTERNATIONAL, FISCAL & SOCIAL
// ----------------------------------------------------

model RhZoneReglementaire {
  id        String   @id @default(uuid())
  code      String   @unique
  libelle   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pays      RhPays[]

  @@map("rh_zone_reglementaire")
}

model RhPays {
  codeIso2                   String              @id @map("code_iso2")
  codeIso3                   String              @unique @map("code_iso3")
  libelle                    String
  zoneReglementaireId        String?             @map("zone_reglementaire_id")
  deviseCode                 String              @map("devise_code")
  langueDefaut               String              @default("fr") @map("langue_defaut")
  organismeSecuSocialeLibelle String?            @map("organisme_secu_sociale_libelle")
  actif                      Boolean             @default(true)
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  zoneReglementaire          RhZoneReglementaire? @relation(fields: [zoneReglementaireId], references: [id])
  baremesIts                 RhBaremeIts[]
  tauxChargesSociales        RhTauxChargeSociale[]
  baremesAvantagesNature     RhBaremeAvantageNature[]
  parametres                 RhParametrePays[]
  joursFeries                RhJourFerie[]
  conventionsCollectives     RhConventionCollective[]
  typesAbsence               RhTypeAbsence[]
  rubriquesPaie              RhRubriquePaie[]
  etablissements             RhEtablissement[]
  declarations               RhDeclarationSocialeFiscale[]

  @@map("rh_pays")
}

model RhBaremeIts {
  id                  String               @id @default(uuid())
  paysCode            String               @map("pays_code")
  codeImpot           String               @map("code_impot")
  libelle             String
  modeCalcul          RhItsCalculationMode @map("mode_calcul")
  periodiciteAssiette RhAssiettePeriodicity @default(MENSUELLE) @map("periodicite_assiette")
  dateDebutValidite   DateTime             @map("date_debut_validite")
  dateFinValidite     DateTime?            @map("date_fin_validite")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  pays                RhPays               @relation(fields: [paysCode], references: [codeIso2])
  tranches            RhBaremeItsTranche[]

  @@index([paysCode, dateDebutValidite])
  @@map("rh_bareme_its")
}

model RhBaremeItsTranche {
  id              String      @id @default(uuid())
  baremeItsId     String      @map("bareme_its_id")
  numeroTranche   Int         @map("numero_tranche")
  limiteInferieure Float      @map("limite_inferieure")
  limiteSuperieure Float?     @map("limite_superieure")
  taux            Float       @map("taux")
  montantDeductionFixe Float  @default(0) @map("montant_deduction_fixe")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  baremeIts       RhBaremeIts @relation(fields: [baremeItsId], references: [id], onDelete: Cascade)

  @@index([baremeItsId, numeroTranche])
  @@map("rh_bareme_its_tranche")
}

model RhTauxChargeSociale {
  id                  String              @id @default(uuid())
  paysCode            String              @map("pays_code")
  code                String
  libelle             String
  typeAssiette        RhAssietteType      @default(SALAIRE_BRUT) @map("type_assiette")
  partSalariale       RhSocialChargeShare @default(PATRONALE) @map("part_salariale")
  tauxSalarial        Float               @default(0) @map("taux_salarial")
  tauxPatronal        Float               @default(0) @map("taux_patronal")
  montantFixe         Float?              @map("montant_fixe")
  plafondMensuel      Float?              @map("plafond_mensuel")
  plancherMensuel     Float?              @map("plancher_mensuel")
  organismeCollecteur String?             @map("organisme_collecteur")
  dateDebutValidite   DateTime            @map("date_debut_validite")
  dateFinValidite     DateTime?           @map("date_fin_validite")
  actif               Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  pays                RhPays              @relation(fields: [paysCode], references: [codeIso2])

  @@index([paysCode, code, dateDebutValidite])
  @@map("rh_taux_charge_sociale")
}

model RhBaremeAvantageNature {
  id                String               @id @default(uuid())
  paysCode          String               @map("pays_code")
  typeAvantage      RhBenefitInKindType  @map("type_avantage")
  tauxPourcentage   Float?               @map("taux_pourcentage")
  montantFixe       Float?               @map("montant_fixe")
  description       String?
  conditionsJson    Json?                @map("conditions_json")
  dateDebutValidite DateTime             @map("date_debut_validite")
  dateFinValidite   DateTime?            @map("date_fin_validite")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  pays              RhPays               @relation(fields: [paysCode], references: [codeIso2])

  @@index([paysCode, typeAvantage])
  @@map("rh_bareme_avantage_nature")
}

model RhParametrePays {
  id                String                  @id @default(uuid())
  paysCode          String                  @map("pays_code")
  codeParametre     String                  @map("code_parametre")
  libelle           String
  typeValeur        RhCountryParamValueType @map("type_valeur")
  valeurTexte       String?                 @map("valeur_texte")
  valeurNumerique   Float?                  @map("valeur_numerique")
  valeurDate        DateTime?               @map("valeur_date")
  valeurJson        Json?                   @map("valeur_json")
  dateDebutValidite DateTime                @map("date_debut_validite")
  dateFinValidite   DateTime?               @map("date_fin_validite")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  pays              RhPays                  @relation(fields: [paysCode], references: [codeIso2])

  @@unique([paysCode, codeParametre, dateDebutValidite])
  @@map("rh_parametre_pays")
}

model RhJourFerie {
  id          String   @id @default(uuid())
  paysCode    String   @map("pays_code")
  dateJour    DateTime @map("date_jour")
  libelle     String
  estChomePaye Boolean @default(true) @map("est_chome_paye")
  annee       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pays        RhPays   @relation(fields: [paysCode], references: [codeIso2])

  @@unique([paysCode, dateJour])
  @@index([paysCode, annee])
  @@map("rh_jour_ferie")
}

// ----------------------------------------------------
// GROUPE B : RÉFÉRENTIEL ORGANISATIONNEL & CONVENTIONNEL
// ----------------------------------------------------

model RhEtablissement {
  id                          String                  @id @default(uuid())
  tenantId                    String                  @map("tenant_id")
  paysCode                    String                  @map("pays_code")
  code                        String
  raisonSociale               String                  @map("raison_sociale")
  identifiantFiscal           String?                 @map("identifiant_fiscal")
  numeroEmployeurSecuSociale  String?                 @map("numero_employeur_secu_sociale")
  conventionCollectiveId      String?                 @map("convention_collective_id")
  adresse                     String?
  ville                       String?
  telephone                   String?
  email                       String?
  estSiege                    Boolean                 @default(false) @map("est_siege")
  actif                       Boolean                 @default(true)
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")

  pays                        RhPays                  @relation(fields: [paysCode], references: [codeIso2])
  conventionCollective        RhConventionCollective? @relation(fields: [conventionCollectiveId], references: [id])
  departements                RhDepartement[]
  affectations                RhEmployeAffectation[]
  contrats                    RhContrat[]
  plannings                   RhPlanningHoraire[]
  cyclesPaie                  RhCyclePaie[]
  declarations                RhDeclarationSocialeFiscale[]
  ecrituresPaie               RhEcritureComptablePaie[]

  @@unique([tenantId, code])
  @@index([tenantId, actif])
  @@map("rh_etablissement")
}

model RhDepartement {
  id                  String                 @id @default(uuid())
  tenantId            String                 @map("tenant_id")
  etablissementId     String                 @map("etablissement_id")
  code                String
  libelle             String
  departementParentId String?                @map("departement_parent_id")
  responsableId       String?                @map("responsable_id")
  actif               Boolean                @default(true)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  etablissement       RhEtablissement        @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  departementParent   RhDepartement?         @relation("DepartementHierarchy", fields: [departementParentId], references: [id])
  sousDepartements    RhDepartement[]        @relation("DepartementHierarchy")
  postes              RhPoste[]
  affectations        RhEmployeAffectation[]
  ecritureLignes      RhEcritureComptablePaieLigne[]

  @@unique([tenantId, etablissementId, code])
  @@index([tenantId, etablissementId])
  @@map("rh_departement")
}

model RhPoste {
  id                          String                      @id @default(uuid())
  tenantId                    String                      @map("tenant_id")
  departementId               String                      @map("departement_id")
  code                        String
  intitule                    String
  description                 String?
  categorieProfessionnelleId  String?                     @map("categorie_professionnelle_id")
  niveauCompetenceRequis      String?                     @map("niveau_competence_requis")
  actif                       Boolean                     @default(true)
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")

  departement                 RhDepartement               @relation(fields: [departementId], references: [id], onDelete: Cascade)
  categorieProfessionnelle    RhCategorieProfessionnelle? @relation(fields: [categorieProfessionnelleId], references: [id])
  affectations                RhEmployeAffectation[]
  contrats                    RhContrat[]

  @@unique([tenantId, code])
  @@index([tenantId, departementId])
  @@map("rh_poste")
}

model RhConventionCollective {
  id                  String                       @id @default(uuid())
  paysCode            String                       @map("pays_code")
  code                String
  libelle             String
  secteurActivite     String?                      @map("secteur_activite")
  dateSignature       DateTime?                    @map("date_signature")
  dateExtensionArrete DateTime?                    @map("date_extension_arrete")
  actif               Boolean                      @default(true)
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  pays                RhPays                       @relation(fields: [paysCode], references: [codeIso2])
  categories          RhCategorieProfessionnelle[]
  etablissements      RhEtablissement[]
  contrats            RhContrat[]

  @@unique([paysCode, code])
  @@map("rh_convention_collective")
}

model RhCategorieProfessionnelle {
  id                      String                  @id @default(uuid())
  conventionCollectiveId  String                  @map("convention_collective_id")
  code                    String
  libelle                 String
  niveauEchelon           String?                 @map("niveau_echelon")
  dureeHebdoLegale        Float                   @default(40) @map("duree_hebdo_legale")
  dureeEssaiMaxMois       Int                     @default(1) @map("duree_essai_max_mois")
  preavisDemissionMois    Int                     @default(1) @map("preavis_demission_mois")
  preavisLicenciementMois Int                     @default(1) @map("preavis_licenciement_mois")
  actif                   Boolean                 @default(true)
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  conventionCollective    RhConventionCollective  @relation(fields: [conventionCollectiveId], references: [id], onDelete: Cascade)
  grillesSalariales       RhGrilleSalariale[]
  postes                  RhPoste[]
  contrats                RhContrat[]

  @@unique([conventionCollectiveId, code])
  @@map("rh_categorie_professionnelle")
}

model RhGrilleSalariale {
  id                      String                     @id @default(uuid())
  categorieId             String                     @map("categorie_id")
  salaireMinimumMensuel   Float                      @map("salaire_minimum_mensuel")
  tauxHoraireMinimum      Float?                     @map("taux_horaire_minimum")
  dateDebutValidite       DateTime                   @map("date_debut_validite")
  dateFinValidite         DateTime?                  @map("date_fin_validite")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  categorie               RhCategorieProfessionnelle @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  @@index([categorieId, dateDebutValidite])
  @@map("rh_grille_salariale")
}

// ----------------------------------------------------
// GROUPE C : EMPLOYÉS & DOSSIERS ADMINISTRATIFS
// ----------------------------------------------------

model RhEmploye {
  id                    String                         @id @default(uuid())
  tenantId              String                         @map("tenant_id")
  matricule             String
  civilite              String?
  nom                   String
  prenoms               String
  nomJeuneFille         String?                        @map("nom_jeune_fille")
  dateNaissance         DateTime?                      @map("date_naissance")
  lieuNaissance         String?                        @map("lieu_naissance")
  nationaliteIso2       String?                        @default("BJ") @map("nationalite_iso2")
  sexe                  RhGender?                      @default(M)
  situationFamiliale    RhMaritalStatus?               @default(CELIBATAIRE) @map("situation_familiale")
  nombreEnfantsCharge   Int                            @default(0) @map("nombre_enfants_charge")
  typePieceIdentite     RhIdentityDocType?             @map("type_piece_identite")
  numeroPieceIdentite   String?                        @map("numero_piece_identite")
  dateExpirationPiece   DateTime?                      @map("date_expiration_piece")
  npi                   String?                        @map("npi")
  numeroCnss            String?                        @map("numero_cnss")
  numeroIfu             String?                        @map("numero_ifu")
  photoUrl              String?                        @map("photo_url")
  emailProfessionnel    String?                        @map("email_professionnel")
  emailPersonnel        String?                        @map("email_personnel")
  telephone1            String?                        @map("telephone_1")
  telephone2            String?                        @map("telephone_2")
  adresseResidence      String?                        @map("adresse_residence")
  villeResidence        String?                        @map("ville_residence")
  paysResidenceIso2     String?                        @default("BJ") @map("pays_residence_iso2")
  statutEmploi          RhEmploymentStatus             @default(ACTIF) @map("statut_emploi")
  dateEntreeEntreprise  DateTime                       @map("date_entree_entreprise")
  dateAnciennete        DateTime                       @map("date_anciennete")
  dateSortieDefinitive  DateTime?                      @map("date_sortie_definitive")
  isDeleted             Boolean                        @default(false) @map("is_deleted")
  createdAt             DateTime                       @default(now()) @map("created_at")
  createdBy             String?                        @map("created_by")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  updatedBy             String?                        @map("updated_by")

  documents             RhEmployeDocument[]
  personnesACharge      RhEmployePersonneACharge[]
  affectations          RhEmployeAffectation[]
  coordonneesBancaires  RhEmployeCoordonneeBancaire[]
  contrats              RhContrat[]
  affectationsHoraires  RhEmployeAffectationHoraire[]
  relevesTemps          RhReleveTemps[]
  absences              RhAbsence[]
  soldesConges          RhSoldeConge[]
  elementsVariables     RhElementVariable[]
  bulletinsPaie         RhBulletinPaie[]
  remunerationsExcep    RhRemunerationExceptionnelle[]
  soldesToutCompte      RhSoldeToutCompte[]
  historiquesSalaire    RhHistoriqueSalaire[]

  @@unique([tenantId, matricule])
  @@index([tenantId, statutEmploi])
  @@index([tenantId, nom, prenoms])
  @@map("rh_employe")
}

model RhEmployeDocument {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  employeId           String    @map("employe_id")
  typeDocument        String    @map("type_document")
  libelle             String
  fichierUrl          String    @map("fichier_url")
  nomFichier          String?   @map("nom_fichier")
  tailleOctets        Int?      @map("taille_octets")
  typeMime            String?   @map("type_mime")
  dateEmission        DateTime? @map("date_emission")
  dateExpiration      DateTime? @map("date_expiration")
  statutVerification  String    @default("EN_ATTENTE") @map("statut_verification")
  verifiePar          String?   @map("verifie_par")
  dateVerification    DateTime? @map("date_verification")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  employe             RhEmploye @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeId])
  @@map("rh_employe_document")
}

model RhEmployePersonneACharge {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  employeId             String    @map("employe_id")
  lienParente           String    @map("lien_parente")
  nomPrenoms            String    @map("nom_prenoms")
  dateNaissance         DateTime  @map("date_naissance")
  estFiscalementACharge Boolean   @default(true) @map("est_fiscalement_a_charge")
  dateDebutPriseEnCharge DateTime @default(now()) @map("date_debut_prise_en_charge")
  dateFinPriseEnCharge  DateTime? @map("date_fin_prise_en_charge")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  employe               RhEmploye @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeId])
  @@map("rh_employe_personne_a_charge")
}

model RhEmployeAffectation {
  id                  String          @id @default(uuid())
  tenantId            String          @map("tenant_id")
  employeId           String          @map("employe_id")
  etablissementId     String          @map("etablissement_id")
  departementId       String          @map("departement_id")
  posteId             String          @map("poste_id")
  dateDebut           DateTime        @map("date_debut")
  dateFin             DateTime?       @map("date_fin")
  motifAffectation    String?         @map("motif_affectation")
  tauxOccupationPct   Float           @default(100) @map("taux_occupation_pct")
  estActuelle         Boolean         @default(true) @map("est_actuelle")
  createdAt           DateTime        @default(now()) @map("created_at")
