// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum ClientType {
  company
  individual
}

enum CatalogItemType {
  product
  service
  package
}

enum InvoiceType {
  standard
  proforma
  deposit
  balance
  credit_note
}

enum InvoiceStatus {
  draft
  issued
  sent
  partial
  paid
  overdue
  cancelled
}

enum QuotationStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
  converted
}

enum OrderStatus {
  draft
  confirmed
  partially_paid
  paid
  cancelled
}

enum PaymentMethod {
  wire
  check
  cash
  card
  other
}

enum ReminderType {
  auto
  manual
}

enum ReminderChannel {
  email
  sms
  print
}

enum NumberingDocumentType {
  quotation
  order_draft
  order_issued
  invoice_draft
  invoice_issued
  client
  catalog_item
}

enum EmailTemplateType {
  quotation_send
  invoice_send
  reminder_level_1
  reminder_level_2
  reminder_level_3
  recurring_invoice
}

enum ExchangeRateSource {
  manual
  api
}

enum PdfLayoutType {
  classic
  modern
  minimal
}

model User {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email    String @unique
  password String

  firstName String @map("first_name")
  lastName  String @map("last_name")

  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  refreshToken String? @map("refresh_token")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]

  @@map("users")
}

model Role {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name        String
  code        String
  description String?

  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  code        String  @unique
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Tenant {
  id   String @id @default(uuid())
  name String

  users User[]

  createdAt DateTime @default(now())

  @@map("tenants")
}

model Client {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code       String
  clientType ClientType @map("client_type")

  companyName String  @map("company_name")
  tradeName   String? @map("trade_name")
  siret       String?
  taxId       String?
  sector      String?

  billingAddress  Json  @map("billing_address")
  shippingAddress Json? @map("shipping_address")

  defaultCurrency      String  @default("EUR") @map("default_currency")
  defaultPaymentTermId String? @map("default_payment_term_id")

  defaultDiscountPct Float? @default(0) @map("default_discount_pct")
  creditLimit        Float?

  notes String?

  remindersDisabled       Boolean @default(false) @map("reminders_disabled")
  remindersDisabledReason String? @map("reminders_disabled_reason")
  blockedForNewOrders     Boolean @default(false) @map("blocked_for_new_orders")

  isArchived Boolean @default(false) @map("is_archived")
  createdBy  String  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime?

  contacts Contact[]

  quotations Quotation[]
  orders     Order[]
  prices     CatalogItemPrice[]

  invoices Invoice[]

  payments Payment[]
  advances ClientAdvance[]
  reminders Reminder[]

  @@unique([tenantId, code])
  @@map("clients")
}

model Contact {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations Quotation[]
  invoices   Invoice[]

  @@map("contacts")
}

model CatalogCategory {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name        String
  code        String?
  description String?

  parentId String? @map("parent_id")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent CatalogCategory? @relation("CategoryTree", fields: [parentId], references: [id])

  children CatalogCategory[] @relation("CategoryTree")

  items CatalogItem[]

  @@unique([tenantId, name])
  @@map("catalog_categories")
}

model CatalogItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  categoryId String? @map("category_id")

  reference   String  @unique
  name        String
  description String?

  itemType CatalogItemType @map("item_type")
  unit     String          @default("unit")

  priceHt Float @map("price_ht")

  defaultTaxRateId String @map("default_tax_rate_id")
  maxDiscountPct   Float? @map("max_discount_pct")

  stockQuantity Float? @default(0) @map("stock_quantity")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  taxRate TaxRate @relation(fields: [defaultTaxRateId], references: [id])

  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  prices         CatalogItemPrice[]

  invoiceLines InvoiceLine[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("catalog_items")
}

model CatalogItemPrice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  itemId String @map("item_id")
  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  groupName String? @map("group_name")
  priceHt   Float   @map("price_ht")
  currency  String  @default("EUR")
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catalog_item_prices")
}

model TaxRate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name String
  rate Float

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  invoiceLines   InvoiceLine[]
  catalogItems   CatalogItem[]

  @@map("tax_rates")
}

model PaymentTerm {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name       String
  days       Int
  endOfMonth Boolean @default(false) @map("end_of_month")
  isDefault  Boolean @default(false)

  quotations Quotation[]
  invoices   Invoice[]

  @@map("payment_terms")
}

model Quotation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number String @unique

  clientId String @map("client_id")

  client    Client  @relation(fields: [clientId], references: [id])
  contactId String?

  contact Contact? @relation(fields: [contactId], references: [id])

  status QuotationStatus @default(draft)

  issueDate  DateTime  @map("issue_date")
  expiryDate DateTime?

  currency     String @default("EUR")
  exchangeRate Float  @default(1)

  paymentTermId String? @map("payment_term_id")

  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  notes         String?
  internalNotes String?

  pdfUrl String?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    QuotationLine[]
  orders   Order[]
  invoices Invoice[]

  @@map("quotations")
}

model QuotationLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  position Int
  itemId   String? @map("item_id")

  item CatalogItem? @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float  @map("unit_price_ht")

  discountPct    Float @default(0)
  discountAmount Float @default(0)

  lineTotalHt Float
  taxRateId   String @map("tax_rate_id")

  taxRate TaxRate @relation(fields: [taxRateId], references: [id])

  taxAmount    Float
  lineTotalTtc Float

  @@map("quotation_lines")
}

model Order {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number      String      @unique
  clientId    String      @map("client_id")
  quotationId String?     @map("quotation_id")
  status      OrderStatus @default(draft)

  client    Client     @relation(fields: [clientId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  issueDate DateTime @map("issue_date")
  currency  String   @default("EUR")

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    OrderLine[]
  invoices Invoice[]

  @@map("orders")
}

model OrderLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  position Int
  itemId   String?      @map("item_id")
  item     CatalogItem? @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float  @map("unit_price_ht")

  discountPct    Float @default(0)
  discountAmount Float @default(0)
  lineTotalHt    Float

  taxRateId String?  @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  taxAmount    Float
  lineTotalTtc Float

  @@map("order_lines")
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number      String        @unique
  invoiceType InvoiceType   @default(standard)
  status      InvoiceStatus @default(draft)

  clientId String @map("client_id")

  client            Client     @relation(fields: [clientId], references: [id])
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id])
  quotation         Quotation? @relation(fields: [quotationId], references: [id])
  order             Order?     @relation(fields: [orderId], references: [id])
  orderId           String?
  quotationId       String?
  originalInvoiceId String?    @map("original_invoice_id")

  originalInvoice Invoice? @relation("CreditNotes", fields: [originalInvoiceId], references: [id])

  creditNotes Invoice[] @relation("CreditNotes")

  issueDate DateTime
  dueDate   DateTime?

  currency     String @default("EUR")
  exchangeRate Float  @default(1)

  paymentTermId String? @map("payment_term_id")

  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  amountPaid Float @default(0)
  amountDue  Float @default(0)

  depositAmount Float?

  notes         String?
  internalNotes String?
  pdfUrl        String?

  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    InvoiceLine[]
  payments PaymentImputation[]
  advanceApplications AdvanceApplication[]

  reminders         Reminder[]
  recurringInvoices RecurringInvoice[] @relation("RecurringTemplate")
  recurringSource   RecurringInvoice?  @relation("RecurringGenerated", fields: [recurringSourceId], references: [id])

  recurringSourceId String? @map("recurring_source_id")

  @@map("invoices")
}

model InvoiceLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  position Int
  itemId   String?

  item CatalogItem? @relation(fields: [itemId], references: [id])

  taxRateId String?  @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float

  discountPct    Float @default(0)
  discountAmount Float @default(0)

  lineTotalHt  Float
  taxAmount    Float
  lineTotalTtc Float

  @@map("invoice_lines")
}

model Payment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  reference   String?
  paymentDate DateTime
  amount      Float

  currency      String        @default("EUR")
  exchangeRate  Float         @default(1) @map("exchange_rate")
  exchangeGainLoss Float?       @map("exchange_gain_loss")
  paymentMethod PaymentMethod @map("payment_method")

  unallocatedAmount Float @default(0) @map("unallocated_amount")

  notes       String?
  isCancelled Boolean @default(false)

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String
  createdAt DateTime @default(now())

  imputations         PaymentImputation[]
  advances            ClientAdvance[]
  advanceApplications AdvanceApplication[]

  @@map("payments")
}

model PaymentImputation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  createdAt DateTime @default(now())

  @@map("payment_imputations")
}

model ClientAdvance {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  sourcePaymentId String  @map("source_payment_id")
  sourcePayment   Payment @relation(fields: [sourcePaymentId], references: [id])

  originalAmount  Float @map("original_amount")
  remainingAmount Float @map("remaining_amount")
  currency        String @default("EUR")

  createdAt DateTime @default(now()) @map("created_at")

  applications AdvanceApplication[]

  @@map("client_advances")
}

model AdvanceApplication {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  advanceId String        @map("advance_id")
  advance   ClientAdvance @relation(fields: [advanceId], references: [id])

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  createdAt DateTime @default(now()) @map("created_at")

  @@map("advance_applications")
}

model Reminder {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceId String @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  level   Int
  type    ReminderType
  channel ReminderChannel

  subject      String?
  sentAt       DateTime
  emailTo      String?
  ccEmails     String? @map("cc_emails")
  bodySnapshot String? @map("body_snapshot")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reminders")
}

model ReminderSettings {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  isEnabled Boolean @default(true) @map("is_enabled")

  level1DaysAfterDue Int @default(3) @map("level1_days_after_due")
  level2DaysAfterDue Int @default(15) @map("level2_days_after_due")
  level3DaysAfterDue Int @default(30) @map("level3_days_after_due")

  level2CopyCommercial  Boolean @default(true) @map("level2_copy_commercial")
  level3AlertDirector   Boolean @default(true) @map("level3_alert_director")
  level3BlockNewOrders  Boolean @default(false) @map("level3_block_new_orders")

  commercialEmail String? @map("commercial_email")
  directorEmail   String? @map("director_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reminder_settings")
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  primaryCurrency      String             @default("EUR") @map("primary_currency")
  exchangeRateSource   ExchangeRateSource @default(manual) @map("exchange_rate_source")

  latePaymentPenaltyRate Float  @default(10) @map("late_payment_penalty_rate")
  latePaymentPenaltyText String? @map("late_payment_penalty_text")

  legalName              String? @map("legal_name")
  tradeName              String? @map("trade_name")
  siret                  String?
  vatNumber              String? @map("vat_number")
  registrationNumber     String? @map("registration_number")
  shareCapital           String? @map("share_capital")
  companyAddress         Json?   @map("company_address")
  companyPhone           String? @map("company_phone")
  companyEmail           String? @map("company_email")
  companyWebsite         String? @map("company_website")
  acceptedPaymentMethods String? @map("accepted_payment_methods")
  cgvText                String? @map("cgv_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model TenantCurrency {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code       String
  name       String
  symbol     String?
  manualRate Float?  @map("manual_rate")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("tenant_currencies")
}

model DocumentNumberingRule {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  documentType  NumberingDocumentType @map("document_type")
  prefix        String
  suffix        String?
  separator     String                @default("-")
  draftMarker   String?               @map("draft_marker")
  includeYear   Boolean               @default(true) @map("include_year")
  counterLength Int                   @default(6) @map("counter_length")
  annualReset   Boolean               @default(true) @map("annual_reset")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, documentType])
  @@map("document_numbering_rules")
}

model EmailTemplate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  type     EmailTemplateType
  subject  String
  body     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, type])
  @@map("email_templates")
}

model PdfTemplate {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  logoUrl            String?       @map("logo_url")
  primaryColor       String        @default("#1a56db") @map("primary_color")
  secondaryColor     String        @default("#6b7280") @map("secondary_color")
  fontFamily         String        @default("Helvetica") @map("font_family")
  layoutType         PdfLayoutType @default(classic) @map("layout_type")
  showPageNumbers    Boolean       @default(true) @map("show_page_numbers")
  headerText         String?       @map("header_text")
  footerText         String?       @map("footer_text")
  legalMentions      String?       @map("legal_mentions")
  termsAndConditions String?       @map("terms_and_conditions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pdf_templates")
}

model DocumentAccessToken {
  id           String   @id @default(uuid())
  token        String   @unique
  tenantId     String   @map("tenant_id")
  documentType String   @map("document_type")
  documentId   String   @map("document_id")
  expiresAt    DateTime @map("expires_at")
  openedAt     DateTime? @map("opened_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("document_access_tokens")
}

model EmailTracking {
  id             String   @id @default(uuid())
  trackingId     String   @unique @map("tracking_id")
  tenantId       String   @map("tenant_id")
  documentType   String   @map("document_type")
  documentId     String   @map("document_id")
  recipientEmail String   @map("recipient_email")
  openedAt       DateTime? @map("opened_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("email_tracking")
}

model RecurringInvoice {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  invoiceId String @map("invoice_id")

  invoice Invoice @relation("RecurringTemplate", fields: [invoiceId], references: [id])

  frequency String

  nextExecution DateTime @map("nextExecution")

  isActive Boolean @default(true) @map("isActive")

  lastNotifiedAt DateTime? @map("last_notified_at")

  lastGeneratedInvoiceId String? @map("last_generated_invoice_id")

  lastGeneratedForExecution DateTime? @map("last_generated_for_execution")

  generatedInvoices Invoice[] @relation("RecurringGenerated")

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("recurring_invoices")
}
