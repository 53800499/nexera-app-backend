// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum ClientType {
  company
  individual
}

enum CatalogItemType {
  product
  service
  package
}

enum InvoiceType {
  standard
  proforma
  deposit
  balance
  credit_note
}

enum InvoiceStatus {
  draft
  issued
  sent
  partial
  paid
  overdue
  cancelled
}

enum QuotationStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
  converted
}

enum OrderStatus {
  draft
  confirmed
  partially_paid
  paid
  cancelled
}

enum PaymentMethod {
  wire
  check
  cash
  card
  other
}

enum ReminderType {
  auto
  manual
}

enum ReminderChannel {
  email
  sms
  print
}

model User {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email    String @unique
  password String

  firstName String @map("first_name")
  lastName  String @map("last_name")

  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  refreshToken String? @map("refresh_token")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]

  @@map("users")
}

model Role {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name        String
  code        String
  description String?

  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  code        String  @unique
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Tenant {
  id   String @id @default(uuid())
  name String

  users User[]

  createdAt DateTime @default(now())

  @@map("tenants")
}

model Client {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code       String
  clientType ClientType @map("client_type")

  companyName String  @map("company_name")
  tradeName   String? @map("trade_name")
  siret       String?
  taxId       String?
  sector      String?

  billingAddress  Json  @map("billing_address")
  shippingAddress Json? @map("shipping_address")

  defaultCurrency      String  @default("EUR") @map("default_currency")
  defaultPaymentTermId String? @map("default_payment_term_id")

  defaultDiscountPct Float? @default(0) @map("default_discount_pct")
  creditLimit        Float?

  notes String?

  isArchived Boolean @default(false) @map("is_archived")
  createdBy  String  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime?

  contacts Contact[]

  quotations Quotation[]
  orders     Order[]
  prices     CatalogItemPrice[]

  invoices Invoice[]

  payments Payment[]

  @@unique([tenantId, code])
  @@map("clients")
}

model Contact {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations Quotation[]
  invoices   Invoice[]

  @@map("contacts")
}

model CatalogCategory {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name        String
  code        String?
  description String?

  parentId String? @map("parent_id")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent CatalogCategory? @relation("CategoryTree", fields: [parentId], references: [id])

  children CatalogCategory[] @relation("CategoryTree")

  items CatalogItem[]

  @@unique([tenantId, name])
  @@map("catalog_categories")
}

model CatalogItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  categoryId String? @map("category_id")

  reference   String  @unique
  name        String
  description String?

  itemType CatalogItemType @map("item_type")
  unit     String          @default("unit")

  priceHt Float @map("price_ht")

  defaultTaxRateId String @map("default_tax_rate_id")
  maxDiscountPct   Float? @map("max_discount_pct")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  taxRate TaxRate @relation(fields: [defaultTaxRateId], references: [id])

  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  prices         CatalogItemPrice[]

  invoiceLines InvoiceLine[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("catalog_items")
}

model CatalogItemPrice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  itemId String @map("item_id")
  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  groupName String? @map("group_name")
  priceHt   Float   @map("price_ht")
  currency  String  @default("EUR")
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catalog_item_prices")
}

model TaxRate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name String
  rate Float

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  invoiceLines   InvoiceLine[]
  catalogItems   CatalogItem[]

  @@map("tax_rates")
}

model PaymentTerm {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name       String
  days       Int
  endOfMonth Boolean @default(false) @map("end_of_month")
  isDefault  Boolean @default(false)

  quotations Quotation[]
  invoices   Invoice[]

  @@map("payment_terms")
}

model Quotation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number String @unique

  clientId String @map("client_id")

  client    Client  @relation(fields: [clientId], references: [id])
  contactId String?

  contact Contact? @relation(fields: [contactId], references: [id])

  status QuotationStatus @default(draft)

  issueDate  DateTime  @map("issue_date")
  expiryDate DateTime?

  currency     String @default("EUR")
  exchangeRate Float  @default(1)

  paymentTermId String? @map("payment_term_id")

  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  notes         String?
  internalNotes String?

  pdfUrl String?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    QuotationLine[]
  orders   Order[]
  invoices Invoice[]

  @@map("quotations")
}

model QuotationLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  position Int
  itemId   String? @map("item_id")

  item CatalogItem? @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float  @map("unit_price_ht")

  discountPct    Float @default(0)
  discountAmount Float @default(0)

  lineTotalHt Float
  taxRateId   String @map("tax_rate_id")

  taxRate TaxRate @relation(fields: [taxRateId], references: [id])

  taxAmount    Float
  lineTotalTtc Float

  @@map("quotation_lines")
}

model Order {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number      String      @unique
  clientId    String      @map("client_id")
  quotationId String?     @map("quotation_id")
  status      OrderStatus @default(draft)

  client    Client     @relation(fields: [clientId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  issueDate DateTime @map("issue_date")
  currency  String   @default("EUR")

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    OrderLine[]
  invoices Invoice[]

  @@map("orders")
}

model OrderLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  position Int
  itemId   String?      @map("item_id")
  item     CatalogItem? @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float  @map("unit_price_ht")

  discountPct    Float @default(0)
  discountAmount Float @default(0)
  lineTotalHt    Float

  taxRateId String?  @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  taxAmount    Float
  lineTotalTtc Float

  @@map("order_lines")
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number      String        @unique
  invoiceType InvoiceType   @default(standard)
  status      InvoiceStatus @default(draft)

  clientId String @map("client_id")

  client            Client     @relation(fields: [clientId], references: [id])
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id])
  quotation         Quotation? @relation(fields: [quotationId], references: [id])
  order             Order?     @relation(fields: [orderId], references: [id])
  orderId           String?
  quotationId       String?
  originalInvoiceId String?    @map("original_invoice_id")

  originalInvoice Invoice? @relation("CreditNotes", fields: [originalInvoiceId], references: [id])

  creditNotes Invoice[] @relation("CreditNotes")

  issueDate DateTime
  dueDate   DateTime?

  currency     String @default("EUR")
  exchangeRate Float  @default(1)

  paymentTermId String? @map("payment_term_id")

  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  amountPaid Float @default(0)
  amountDue  Float @default(0)

  depositAmount Float?

  notes         String?
  internalNotes String?
  pdfUrl        String?

  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    InvoiceLine[]
  payments PaymentImputation[]

  reminders         Reminder[]
  recurringInvoices RecurringInvoice[]

  @@map("invoices")
}

model InvoiceLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  position Int
  itemId   String?

  item CatalogItem? @relation(fields: [itemId], references: [id])

  taxRateId String?  @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float

  discountPct    Float @default(0)
  discountAmount Float @default(0)

  lineTotalHt  Float
  taxAmount    Float
  lineTotalTtc Float

  @@map("invoice_lines")
}

model Payment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  reference   String?
  paymentDate DateTime
  amount      Float

  currency      String        @default("EUR")
  paymentMethod PaymentMethod @map("payment_method")

  notes       String?
  isCancelled Boolean @default(false)

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String
  createdAt DateTime @default(now())

  imputations PaymentImputation[]

  @@map("payments")
}

model PaymentImputation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  createdAt DateTime @default(now())

  @@map("payment_imputations")
}

model Reminder {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceId String @map("invoice_id")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  level   Int
  type    ReminderType
  channel ReminderChannel

  sentAt       DateTime
  emailTo      String?
  bodySnapshot String?

  createdBy String?

  createdAt DateTime @default(now())

  @@map("reminders")
}

model RecurringInvoice {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  invoiceId String @map("invoice_id")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  frequency String

  nextExecution DateTime

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("recurring_invoices")
}
