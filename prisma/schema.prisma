  dateNotificationRupture DateTime?         @map("date_notification_rupture")
  motifRupture            String?           @map("motif_rupture")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  contrat                 RhContrat         @relation(fields: [contratId], references: [id], onDelete: Cascade)

  @@map("rh_contrat_periode_essai")
}

model RhContratAvenant {
  id                    String           @id @default(uuid())
  contratId             String           @map("contrat_id")
