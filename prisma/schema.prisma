  updatedAt          DateTime        @updatedAt @map("updated_at")
  isDeleted          Boolean         @default(false) @map("is_deleted")

  employe            RhEmploye       @relation(fields: [employeRefId], references: [id])
  mission            NdfMission?     @relation(fields: [missionId], references: [id])
