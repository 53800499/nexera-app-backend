  bulletinPaieId                  String?                     @map("bulletin_paie_id")
  dateEtablissement               DateTime                    @map("date_etablissement")
  montantDernierSalaireNet        Float                       @default(0) @map("montant_dernier_salaire_net")
  montantIndemnitePreavisNet      Float                       @default(0) @map("montant_indemnite_preavis_net")
  montantIndemniteLicenciementNet Float                       @default(0) @map("montant_indemnite_licenciement_net")
  montantIndemniteCongesPayesNet  Float                       @default(0) @map("montant_indemnite_conges_payes_net")
  montantRetenuesDiverses         Float                       @default(0) @map("montant_retenues_diverses")
  montantTotalNet                 Float                       @map("montant_total_net")
  recuPourSoldeSigne              Boolean                     @default(false) @map("recu_pour_solde_signe")
  dateSignature                   DateTime?                   @map("date_signature")
  statutSignature                 RhSeveranceSignatureStatus  @default(EN_ATTENTE_SIGNATURE) @map("statut_signature")
  certificatTravailGenere         Boolean                     @default(true) @map("certificat_travail_genere")
  fichierStcUrl                   String?                     @map("fichier_stc_url")
  createdAt                       DateTime                    @default(now()) @map("created_at")
  updatedAt                       DateTime                    @updatedAt @map("updated_at")

  employe                         RhEmploye                   @relation(fields: [employeId], references: [id], onDelete: Cascade)
  contratRupture                  RhContratRupture?           @relation(fields: [contratRuptureId], references: [id])
  bulletinPaie                    RhBulletinPaie?             @relation(fields: [bulletinPaieId], references: [id])

  @@index([tenantId, employeId])
  @@map("rh_solde_tout_compte")
}

model RhHistoriqueSalaire {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  employeId           String            @map("employe_id")
  dateEffet           DateTime          @map("date_effet")
  ancienSalaireBase   Float             @map("ancien_salaire_base")
  nouveauSalaireBase  Float             @map("nouveau_salaire_base")
  motifChangement     String?           @map("motif_changement")
  referenceAvenantId  String?           @map("reference_avenant_id")
  creePar             String?           @map("cree_par")
  createdAt           DateTime          @default(now()) @map("created_at")

  employe             RhEmploye         @relation(fields: [employeId], references: [id], onDelete: Cascade)
  avenant             RhContratAvenant? @relation(fields: [referenceAvenantId], references: [id])

  @@index([tenantId, employeId, dateEffet])
  @@map("rh_historique_salaire")
}

// ----------------------------------------------------
// GROUPE G : INTERFACES INTERMODULAIRES (M3 & M7)
// ----------------------------------------------------

model RhDeclarationSocialeFiscale {
  id                    String              @id @default(uuid())
  tenantId              String              @map("tenant_id")
  etablissementId       String              @map("etablissement_id")
  cyclePaieId           String              @map("cycle_paie_id")
  paysCode              String              @map("pays_code")
  typeDeclaration       RhDeclarationType   @map("type_declaration")
  periodeDeclaration    String              @map("periode_declaration") // YYYY-MM
  montantBase           Float               @map("montant_base")
  montantTotal          Float               @map("montant_total")
  nombreSalariesConcernes Int               @map("nombre_salaries_concernes")
  dateLimiteLegale      DateTime            @map("date_limite_legale")
  statut                RhDeclarationStatus @default(A_DECLARER)
  dateTransmissionM7    DateTime?           @map("date_transmission_m7")
  referenceObjetM7      String?             @map("reference_objet_m7")
  fichierDeclarationUrl String?             @map("fichier_declaration_url")
  payloadJson           Json?               @map("payload_json")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  etablissement         RhEtablissement     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  cyclePaie             RhCyclePaie         @relation(fields: [cyclePaieId], references: [id], onDelete: Cascade)
  pays                  RhPays              @relation(fields: [paysCode], references: [codeIso2])

  @@unique([tenantId, etablissementId, cyclePaieId, typeDeclaration])
  @@index([tenantId, statut])
  @@map("rh_declaration_sociale_fiscale")
}

model RhEcritureComptablePaie {
  id                  String                       @id @default(uuid())
  tenantId            String                       @map("tenant_id")
  etablissementId     String                       @map("etablissement_id")
  cyclePaieId         String                       @map("cycle_paie_id")
  dateEcriture        DateTime                     @map("date_ecriture")
  journalCode         String                       @default("OD") @map("journal_code")
  libellePiece        String                       @map("libelle_piece")
  montantTotalDebit   Float                        @map("montant_total_debit")
  montantTotalCredit  Float                        @map("montant_total_credit")
  estEquilibree       Boolean                      @default(true) @map("est_equilibree")
  statut              RhAccountingEntryStatus      @default(GENERE)
  dateTransmissionM3  DateTime?                    @map("date_transmission_m3")
  referenceEcritureM3 String?                      @map("reference_ecriture_m3")
  erreurTransmission  String?                      @map("erreur_transmission")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  etablissement       RhEtablissement              @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  cyclePaie           RhCyclePaie                  @relation(fields: [cyclePaieId], references: [id], onDelete: Cascade)
  lignes              RhEcritureComptablePaieLigne[]

  @@unique([tenantId, cyclePaieId])
  @@index([tenantId, statut])
  @@map("rh_ecriture_comptable_paie")
}

model RhEcritureComptablePaieLigne {
  id                    String                  @id @default(uuid())
  ecriturePaieId        String                  @map("ecriture_paie_id")
  numeroLigne           Int                     @map("numero_ligne")
  compteNumero          String                  @map("compte_numero")
  tiersCode             String?                 @map("tiers_code")
  libelle               String
  montantDebit          Float                   @default(0) @map("montant_debit")
  montantCredit         Float                   @default(0) @map("montant_credit")
  departementId         String?                 @map("departement_id")
  rubriquePaieId        String?                 @map("rubrique_paie_id")
  createdAt             DateTime                @default(now()) @map("created_at")

  ecriturePaie          RhEcritureComptablePaie @relation(fields: [ecriturePaieId], references: [id], onDelete: Cascade)
  departement           RhDepartement?          @relation(fields: [departementId], references: [id])
  rubriquePaie          RhRubriquePaie?         @relation(fields: [rubriquePaieId], references: [id])

  @@index([ecriturePaieId, numeroLigne])
  @@map("rh_ecriture_comptable_paie_ligne")
}

// ----------------------------------------------------
// GROUPE H : IMPORT / EXPORT & AUDIT
// ----------------------------------------------------

model RhConnecteurEchange {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  code              String
  libelle           String
  typeConnecteur    RhConnectorType   @map("type_connecteur")
  configurationJson Json?             @map("configuration_json")
  actif             Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  mappings          RhMappingChamp[]
  jobs              RhJobImportExport[]

  @@unique([tenantId, code])
  @@map("rh_connecteur_echange")
}

model RhMappingChamp {
  id                  String              @id @default(uuid())
  connecteurId        String              @map("connecteur_id")
  champExterne        String              @map("champ_externe")
  tableCible          String              @map("table_cible")
  colonneCible        String              @map("colonne_cible")
  typeTransformation  String?             @map("type_transformation")
  regleTransformation Json?               @map("regle_transformation")
  estObligatoire      Boolean             @default(false) @map("est_obligatoire")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  connecteur          RhConnecteurEchange @relation(fields: [connecteurId], references: [id], onDelete: Cascade)

  @@index([connecteurId])
  @@map("rh_mapping_champ")
}

model RhJobImportExport {
  id                    String              @id @default(uuid())
  tenantId              String              @map("tenant_id")
  connecteurId          String?             @map("connecteur_id")
  typeOperation         RhJobType           @map("type_operation")
  entiteCible           String              @map("entite_cible")
  nomFichier            String?             @map("nom_fichier")
  dateExecution         DateTime            @default(now()) @map("date_execution")
  dureeMs               Int?                @map("duree_ms")
  nombreLignesTraitees  Int                 @default(0) @map("nombre_lignes_traitees")
  nombreSucces          Int                 @default(0) @map("nombre_succes")
  nombreErreurs         Int                 @default(0) @map("nombre_erreurs")
  rapportErreursJson    Json?               @map("rapport_erreurs_json")
  statut                RhJobStatus         @default(EN_COURS)
  executePar            String?             @map("execute_par")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  connecteur            RhConnecteurEchange? @relation(fields: [connecteurId], references: [id])

  @@index([tenantId, typeOperation, dateExecution])
  @@map("rh_job_import_export")
}

model RhJournalAudit {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  utilisateurId       String?        @map("utilisateur_id")
  entiteNom           String         @map("entite_nom")
  entiteId            String?        @map("entite_id")
  actionAudit         RhAuditAction  @map("action_audit")
  champsModifiesJson  Json?          @map("champs_modifies_json")
  adresseIp           String?        @map("adresse_ip")
  userAgent           String?        @map("user_agent")
  dateAction          DateTime       @default(now()) @map("date_action")

  @@index([tenantId, entiteNom, dateAction])
  @@index([tenantId, utilisateurId])
  @@map("rh_journal_audit")
}
