  historiquesSalaire    RhHistoriqueSalaire[]
  missionsNdf           NdfMission[]
  avancesFraisNdf       NdfAvanceFrais[]
  rapportsFraisNdf      NdfRapportFrais[]
  cartesAffairesNdf     NdfCarteAffaire[]

  @@unique([tenantId, matricule])
  @@index([tenantId, statutEmploi])
  @@index([tenantId, nom, prenoms])
  @@map("rh_employe")
}

model RhEmployeDocument {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  employeId           String    @map("employe_id")
