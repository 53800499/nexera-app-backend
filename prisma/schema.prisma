// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum ClientType {
  company
  individual
}

enum CatalogItemType {
  product
  service
  package
}

enum InvoiceType {
  standard
  proforma
  deposit
  balance
  credit_note
}

enum InvoiceStatus {
  draft
  issued
  sent
  partial
  paid
  overdue
  cancelled
}

enum QuotationStatus {
  draft
  sent
  viewed
  accepted
  declined
  expired
  converted
}

enum OrderStatus {
  draft
  confirmed
  partially_paid
  paid
  cancelled
}

enum PaymentMethod {
  wire
  check
  cash
  card
  other
}

enum ReminderType {
  auto
  manual
}

enum ReminderChannel {
  email
  sms
  print
}

enum NumberingDocumentType {
  quotation
  order_draft
  order_issued
  invoice_draft
  invoice_issued
  client
  catalog_item
  stock_receipt
  stock_issue
  stock_transfer
  stock_inventory
  purchase_request
}

enum EmailTemplateType {
  quotation_send
  invoice_send
  reminder_level_1
  reminder_level_2
  reminder_level_3
  recurring_invoice
}

enum ExchangeRateSource {
  manual
  api
}

enum PdfLayoutType {
  classic
  modern
  minimal
}

enum AuditEntityType {
  invoice
  quotation
  payment
  order
}

enum AuditAction {
  create
  update
  delete
  issue
  send
  cancel
  record_payment
  cancel_payment
  convert
}

model User {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email    String @unique
  password String

  firstName String @map("first_name")
  lastName  String @map("last_name")

  isActive     Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  refreshToken String? @map("refresh_token")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Role {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name        String
  code        String
  description String?

  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  code        String  @unique
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Tenant {
  id   String     @id @default(uuid())
  name String
  type TenantType @default(company)

  /// Code d'invitation partagé aux entreprises (type cabinet uniquement).
  cabinetInviteCode String? @unique @map("cabinet_invite_code")

  users User[]

  cabinetLinks CabinetCompanyAccess[] @relation("CabinetTenant")
  companyLinks CabinetCompanyAccess[] @relation("CompanyTenant")

  createdAt DateTime @default(now())

  @@map("tenants")
}

enum TenantType {
  company
  cabinet
}

model CabinetCompanyAccess {
  id              String @id @default(uuid())
  cabinetTenantId String @map("cabinet_tenant_id")
  companyTenantId String @map("company_tenant_id")

  /// Droits accordés par l'entreprise au cabinet sur ce dossier.
  permissions String[] @default(["cabinet.scope.invoices.read"])

  cabinetTenant Tenant @relation("CabinetTenant", fields: [cabinetTenantId], references: [id])
  companyTenant Tenant @relation("CompanyTenant", fields: [companyTenantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cabinetTenantId, companyTenantId])
  @@map("cabinet_company_access")
}

model Client {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code       String
  clientType ClientType @map("client_type")

  companyName String  @map("company_name")
  tradeName   String? @map("trade_name")
  siret       String?
  taxId       String?
  sector      String?

  billingAddress  Json  @map("billing_address")
  shippingAddress Json? @map("shipping_address")

  defaultCurrency      String  @default("EUR") @map("default_currency")
  defaultPaymentTermId String? @map("default_payment_term_id")

  defaultDiscountPct Float? @default(0) @map("default_discount_pct")
  creditLimit        Float?

  notes String?

  remindersDisabled       Boolean @default(false) @map("reminders_disabled")
  remindersDisabledReason String? @map("reminders_disabled_reason")
  blockedForNewOrders     Boolean @default(false) @map("blocked_for_new_orders")

  isArchived Boolean @default(false) @map("is_archived")
  createdBy  String  @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime?

  contacts Contact[]

  quotations Quotation[]
  orders     Order[]
  prices     CatalogItemPrice[]

  invoices Invoice[]

  payments Payment[]
  advances ClientAdvance[]
  reminders Reminder[]

  @@unique([tenantId, code])
  @@map("clients")
}

model Contact {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations Quotation[]
  invoices   Invoice[]

  @@map("contacts")
}

model CatalogCategory {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name        String
  code        String?
  description String?

  parentId String? @map("parent_id")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent CatalogCategory? @relation("CategoryTree", fields: [parentId], references: [id])

  children CatalogCategory[] @relation("CategoryTree")

  items CatalogItem[]

  @@unique([tenantId, name])
  @@map("catalog_categories")
}

model CatalogItem {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  categoryId String? @map("category_id")

  reference   String  @unique
  name        String
  description String?

  itemType CatalogItemType @map("item_type")
  unit     String          @default("unit")

  priceHt Float @map("price_ht")

  defaultTaxRateId String @map("default_tax_rate_id")
  maxDiscountPct   Float? @map("max_discount_pct")

  stockQuantity Float? @default(0) @map("stock_quantity")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  taxRate TaxRate @relation(fields: [defaultTaxRateId], references: [id])

  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  prices         CatalogItemPrice[]

  invoiceLines InvoiceLine[]
  stockItem    StockItem?

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("catalog_items")
}

model CatalogItemPrice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  itemId String @map("item_id")
  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  groupName String? @map("group_name")
  priceHt   Float   @map("price_ht")
  currency  String  @default("EUR")
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catalog_item_prices")
}

model TaxRate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name String
  rate Float

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  quotationLines QuotationLine[]
  orderLines     OrderLine[]
  invoiceLines   InvoiceLine[]
  catalogItems   CatalogItem[]

  @@map("tax_rates")
}

model PaymentTerm {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  name       String
  days       Int
  endOfMonth Boolean @default(false) @map("end_of_month")
  isDefault  Boolean @default(false)

  quotations Quotation[]
  invoices   Invoice[]

  @@map("payment_terms")
}

model Quotation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number String @unique

  clientId String @map("client_id")

  client    Client  @relation(fields: [clientId], references: [id])
  contactId String?

  contact Contact? @relation(fields: [contactId], references: [id])

  status QuotationStatus @default(draft)

  issueDate  DateTime  @map("issue_date")
  expiryDate DateTime?

  currency     String @default("EUR")
  exchangeRate Float  @default(1)

  paymentTermId String? @map("payment_term_id")

  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  notes         String?
  internalNotes String?

  pdfUrl String?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    QuotationLine[]
  orders   Order[]
  invoices Invoice[]

  @@map("quotations")
}

model QuotationLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  quotationId String    @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  position Int
  itemId   String? @map("item_id")

  item CatalogItem? @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float  @map("unit_price_ht")

  discountPct    Float @default(0)
  discountAmount Float @default(0)

  lineTotalHt Float
  taxRateId   String @map("tax_rate_id")

  taxRate TaxRate @relation(fields: [taxRateId], references: [id])

  taxAmount    Float
  lineTotalTtc Float

  @@map("quotation_lines")
}

model Order {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number      String      @unique
  clientId    String      @map("client_id")
  quotationId String?     @map("quotation_id")
  status      OrderStatus @default(draft)

  client    Client     @relation(fields: [clientId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  issueDate DateTime @map("issue_date")
  currency  String   @default("EUR")

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    OrderLine[]
  invoices Invoice[]

  @@map("orders")
}

model OrderLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  position Int
  itemId   String?      @map("item_id")
  item     CatalogItem? @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float  @map("unit_price_ht")

  discountPct    Float @default(0)
  discountAmount Float @default(0)
  lineTotalHt    Float

  taxRateId String?  @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  taxAmount    Float
  lineTotalTtc Float

  @@map("order_lines")
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  number      String        @unique
  invoiceType InvoiceType   @default(standard)
  status      InvoiceStatus @default(draft)

  clientId String @map("client_id")

  client            Client     @relation(fields: [clientId], references: [id])
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id])
  quotation         Quotation? @relation(fields: [quotationId], references: [id])
  order             Order?     @relation(fields: [orderId], references: [id])
  orderId           String?
  quotationId       String?
  originalInvoiceId String?    @map("original_invoice_id")

  originalInvoice Invoice? @relation("CreditNotes", fields: [originalInvoiceId], references: [id])

  creditNotes Invoice[] @relation("CreditNotes")

  issueDate DateTime
  dueDate   DateTime?

  currency     String @default("EUR")
  exchangeRate Float  @default(1)

  paymentTermId String? @map("payment_term_id")

  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  subtotalHt     Float
  discountPct    Float @default(0)
  discountAmount Float @default(0)
  baseHt         Float
  totalTax       Float
  totalTtc       Float

  amountPaid Float @default(0)
  amountDue  Float @default(0)

  depositAmount Float?

  notes         String?
  internalNotes String?
  pdfUrl        String?

  sentAt      DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    InvoiceLine[]
  payments PaymentImputation[]
  advanceApplications AdvanceApplication[]

  reminders         Reminder[]
  recurringInvoices RecurringInvoice[] @relation("RecurringTemplate")
  recurringSource   RecurringInvoice?  @relation("RecurringGenerated", fields: [recurringSourceId], references: [id])

  recurringSourceId String? @map("recurring_source_id")

  @@map("invoices")
}

model InvoiceLine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  position Int
  itemId   String?

  item CatalogItem? @relation(fields: [itemId], references: [id])

  taxRateId String?  @map("tax_rate_id")
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  description String
  quantity    Float
  unitPriceHt Float

  discountPct    Float @default(0)
  discountAmount Float @default(0)

  lineTotalHt  Float
  taxAmount    Float
  lineTotalTtc Float

  @@map("invoice_lines")
}

model Payment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  reference   String?
  paymentDate DateTime
  amount      Float

  currency      String        @default("EUR")
  exchangeRate  Float         @default(1) @map("exchange_rate")
  exchangeGainLoss Float?       @map("exchange_gain_loss")
  paymentMethod PaymentMethod @map("payment_method")

  unallocatedAmount Float @default(0) @map("unallocated_amount")

  notes       String?
  isCancelled Boolean @default(false)

  cancelledAt  DateTime?
  cancelReason String?

  createdBy String
  createdAt DateTime @default(now())

  imputations         PaymentImputation[]
  advances            ClientAdvance[]
  advanceApplications AdvanceApplication[]

  @@map("payments")
}

model PaymentImputation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  createdAt DateTime @default(now())

  @@map("payment_imputations")
}

model ClientAdvance {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  sourcePaymentId String  @map("source_payment_id")
  sourcePayment   Payment @relation(fields: [sourcePaymentId], references: [id])

  originalAmount  Float @map("original_amount")
  remainingAmount Float @map("remaining_amount")
  currency        String @default("EUR")

  createdAt DateTime @default(now()) @map("created_at")

  applications AdvanceApplication[]

  @@map("client_advances")
}

model AdvanceApplication {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  advanceId String        @map("advance_id")
  advance   ClientAdvance @relation(fields: [advanceId], references: [id])

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount Float

  createdAt DateTime @default(now()) @map("created_at")

  @@map("advance_applications")
}

model Reminder {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  invoiceId String @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  level   Int
  type    ReminderType
  channel ReminderChannel

  subject      String?
  sentAt       DateTime
  emailTo      String?
  ccEmails     String? @map("cc_emails")
  bodySnapshot String? @map("body_snapshot")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reminders")
}

model ReminderSettings {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  isEnabled Boolean @default(true) @map("is_enabled")

  level1DaysAfterDue Int @default(3) @map("level1_days_after_due")
  level2DaysAfterDue Int @default(15) @map("level2_days_after_due")
  level3DaysAfterDue Int @default(30) @map("level3_days_after_due")

  level2CopyCommercial  Boolean @default(true) @map("level2_copy_commercial")
  level3AlertDirector   Boolean @default(true) @map("level3_alert_director")
  level3BlockNewOrders  Boolean @default(false) @map("level3_block_new_orders")

  commercialEmail String? @map("commercial_email")
  directorEmail   String? @map("director_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reminder_settings")
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  primaryCurrency      String             @default("EUR") @map("primary_currency")
  exchangeRateSource   ExchangeRateSource @default(manual) @map("exchange_rate_source")

  latePaymentPenaltyRate Float  @default(10) @map("late_payment_penalty_rate")
  latePaymentPenaltyText String? @map("late_payment_penalty_text")

  legalName              String? @map("legal_name")
  tradeName              String? @map("trade_name")
  siret                  String?
  vatNumber              String? @map("vat_number")
  registrationNumber     String? @map("registration_number")
  shareCapital           String? @map("share_capital")
  companyAddress         Json?   @map("company_address")
  companyPhone           String? @map("company_phone")
  companyEmail           String? @map("company_email")
  companyWebsite         String? @map("company_website")
  acceptedPaymentMethods String? @map("accepted_payment_methods")
  cgvText                String? @map("cgv_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model TenantCurrency {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  code       String
  name       String
  symbol     String?
  manualRate Float?  @map("manual_rate")
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("tenant_currencies")
}

model DocumentNumberingRule {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  documentType  NumberingDocumentType @map("document_type")
  prefix        String
  suffix        String?
  separator     String                @default("-")
  draftMarker   String?               @map("draft_marker")
  includeYear   Boolean               @default(true) @map("include_year")
  counterLength Int                   @default(6) @map("counter_length")
  annualReset   Boolean               @default(true) @map("annual_reset")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, documentType])
  @@map("document_numbering_rules")
}

model EmailTemplate {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  type     EmailTemplateType
  subject  String
  body     String
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, type])
  @@map("email_templates")
}

model PdfTemplate {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  logoUrl            String?       @map("logo_url")
  primaryColor       String        @default("#1a56db") @map("primary_color")
  secondaryColor     String        @default("#6b7280") @map("secondary_color")
  fontFamily         String        @default("Helvetica") @map("font_family")
  layoutType         PdfLayoutType @default(classic) @map("layout_type")
  showPageNumbers    Boolean       @default(true) @map("show_page_numbers")
  headerText         String?       @map("header_text")
  footerText         String?       @map("footer_text")
  legalMentions      String?       @map("legal_mentions")
  termsAndConditions String?       @map("terms_and_conditions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pdf_templates")
}

model DocumentAccessToken {
  id           String   @id @default(uuid())
  token        String   @unique
  tenantId     String   @map("tenant_id")
  documentType String   @map("document_type")
  documentId   String   @map("document_id")
  expiresAt    DateTime @map("expires_at")
  openedAt     DateTime? @map("opened_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("document_access_tokens")
}

model EmailTracking {
  id             String   @id @default(uuid())
  trackingId     String   @unique @map("tracking_id")
  tenantId       String   @map("tenant_id")
  documentType   String   @map("document_type")
  documentId     String   @map("document_id")
  recipientEmail String   @map("recipient_email")
  openedAt       DateTime? @map("opened_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("email_tracking")
}

model RecurringInvoice {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  invoiceId String @map("invoice_id")

  invoice Invoice @relation("RecurringTemplate", fields: [invoiceId], references: [id])

  frequency String

  nextExecution DateTime @map("nextExecution")

  isActive Boolean @default(true) @map("isActive")

  lastNotifiedAt DateTime? @map("last_notified_at")

  lastGeneratedInvoiceId String? @map("last_generated_invoice_id")

  lastGeneratedForExecution DateTime? @map("last_generated_for_execution")

  generatedInvoices Invoice[] @relation("RecurringGenerated")

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("recurring_invoices")
}

model AuditLog {
  id         String          @id @default(uuid())
  tenantId   String          @map("tenant_id")
  userId     String?         @map("user_id")
  entityType AuditEntityType @map("entity_type")
  entityId   String          @map("entity_id")
  action     AuditAction
  changes    Json?
  metadata   Json?
  ipAddress  String?         @map("ip_address")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

enum SyncMutationStatus {
  applied
  conflict
  rejected
  duplicate
}

/// Module 2 — Gestion des Stocks (UC-S01)
enum StockValuationMethod {
  cmup
  fifo
  lifo
}

model Warehouse {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  code           String
  name           String
  address        Json?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  managerUserId  String?  @map("manager_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  locations            WarehouseLocation[]
  defaultForStockItems StockItem[]         @relation("StockItemDefaultWarehouse")
  stockLevels          StockLevel[]
  movements            StockMovement[]
  transfersAsSource    StockTransfer[]     @relation("TransferSourceWarehouse")
  transfersAsDest      StockTransfer[]     @relation("TransferDestWarehouse")
  inventorySessions    InventorySession[]
  alerts               StockAlert[]
  replenishments       ReplenishmentProposal[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  code        String
  zone        String?
  aisle       String?
  rack        String?
  bin         String?
  capacity    Float?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  defaultForStockItems StockItem[]         @relation("StockItemDefaultLocation")
  stockLevels          StockLevel[]
  movementLines        StockMovementLine[]
  serials              StockItemSerial[]
  transferLinesSource  StockTransferLine[] @relation("TransferLineSourceLocation")
  transferLinesDest    StockTransferLine[] @relation("TransferLineDestLocation")
  inventoryLines       InventoryCountLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("warehouse_locations")
}

model StockItem {
  id                  String                @id @default(uuid())
  tenantId            String                @map("tenant_id")
  commercialItemId    String                @map("commercial_item_id")
  trackLots           Boolean               @default(false) @map("track_lots")
  trackSerials        Boolean               @default(false) @map("track_serials")
  trackExpiry         Boolean               @default(false) @map("track_expiry")
  /** Seuil alerte péremption (jours) — §3.3 */
  expiryAlertDays     Int                   @default(30) @map("expiry_alert_days")
  valuationMethod     StockValuationMethod  @default(cmup) @map("valuation_method")
  storageUnit         String                @map("storage_unit")
  conversionFactor    Float                 @default(1) @map("conversion_factor")
  minStockQty         Float?                @map("min_stock_qty")
  safetyStockQty      Float?                @map("safety_stock_qty")
  maxStockQty         Float?                @map("max_stock_qty")
  reorderQty          Float?                @map("reorder_qty")
  defaultWarehouseId  String?               @map("default_warehouse_id")
  defaultLocationId   String?               @map("default_location_id")
  allowNegativeStock  Boolean               @default(false) @map("allow_negative_stock")
  currentCmup         Float                 @default(0) @map("current_cmup")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  commercialItem   CatalogItem         @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)
  defaultWarehouse Warehouse?          @relation("StockItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  defaultLocation  WarehouseLocation?  @relation("StockItemDefaultLocation", fields: [defaultLocationId], references: [id])
  lots             StockItemLot[]
  serials          StockItemSerial[]
  levels           StockLevel[]
  movementLines    StockMovementLine[]
  transferLines    StockTransferLine[]
  inventoryLines   InventoryCountLine[]
  alerts           StockAlert[]
  replenishments   ReplenishmentProposal[]
  cmupHistory      StockCmupHistory[]

  @@unique([commercialItemId])
  @@index([tenantId])
  @@index([tenantId, valuationMethod])
  @@map("stock_items")
}

enum StockMovementType {
  IN_SUPPLIER
  IN_RETURN
  IN_PRODUCTION
  IN_ADJUSTMENT
  IN_INITIAL
  OUT_SALE
  OUT_CONSUMPTION
  OUT_LOSS
  OUT_RETURN_SUPPLIER
  OUT_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum StockMovementStatus {
  draft
  validated
  cancelled
}

enum StockQualityStatus {
  accepted
  partial
  rejected
}

enum StockSerialStatus {
  in_stock
  sold
  transferred
  scrapped
}

enum StockAlertLevel {
  ok
  warning
  critical
}

model StockItemLot {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  stockItemId      String   @map("stock_item_id")
  lotNumber        String   @map("lot_number")
  manufactureDate  DateTime? @map("manufacture_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  receivedDate     DateTime @default(now()) @map("received_date") @db.Date
  supplierId       String?  @map("supplier_id")
  initialQty       Float    @default(0) @map("initial_qty")
  remainingQty     Float    @default(0) @map("remaining_qty")
  unitCost         Float    @default(0) @map("unit_cost")
  isQuarantine     Boolean  @default(false) @map("is_quarantine")
  quarantineReason String?  @map("quarantine_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  stockItem     StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  levels        StockLevel[]
  movementLines StockMovementLine[]
  serials       StockItemSerial[]
  transferLines StockTransferLine[]
  inventoryLines InventoryCountLine[]
  alerts         StockAlert[]

  @@unique([stockItemId, lotNumber])
  @@index([tenantId])
  @@index([expiryDate])
  @@map("stock_item_lots")
}

model StockItemSerial {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  stockItemId    String            @map("stock_item_id")
  serialNumber   String            @map("serial_number")
  lotId          String?           @map("lot_id")
  status         StockSerialStatus @default(in_stock)
  warehouseId    String?           @map("warehouse_id")
  locationId     String?           @map("location_id")
  receivedDate   DateTime          @default(now()) @map("received_date") @db.Date
  soldInvoiceId  String?           @map("sold_invoice_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  stockItem StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@unique([stockItemId, serialNumber])
  @@index([tenantId])
  @@map("stock_item_serials")
}

model StockLevel {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  stockItemId   String          @map("stock_item_id")
  warehouseId   String          @map("warehouse_id")
  locationId    String?         @map("location_id")
  lotId         String?         @map("lot_id")
  qtyOnHand     Float           @default(0) @map("qty_on_hand")
  qtyReserved   Float           @default(0) @map("qty_reserved")
  qtyAvailable  Float           @default(0) @map("qty_available")
  qtyIncoming   Float           @default(0) @map("qty_incoming")
  unitValue     Float           @default(0) @map("unit_value")
  totalValue    Float           @default(0) @map("total_value")
  alertLevel    StockAlertLevel @default(ok) @map("alert_level")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  stockItem StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])

  @@index([tenantId, stockItemId, warehouseId])
  @@index([tenantId, alertLevel])
  @@index([stockItemId, lotId])
  @@map("stock_levels")
}

model StockMovement {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  number             String
  movementType       StockMovementType   @map("movement_type")
  status             StockMovementStatus @default(draft)
  warehouseId        String              @map("warehouse_id")
  movementDate       DateTime            @default(now()) @map("movement_date") @db.Date
  reference          String?
  invoiceId          String?             @map("invoice_id")
  transferId         String?             @map("transfer_id")
  inventorySessionId String?             @map("inventory_session_id")
  supplierId         String?             @map("supplier_id")
  qualityStatus      StockQualityStatus? @map("quality_status")
  reason             String?
  approvedBy         String?             @map("approved_by")
  approvedAt         DateTime?           @map("approved_at")
  notes              String?
  createdBy          String              @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     StockMovementLine[]
  inventorySession InventorySession? @relation(fields: [inventorySessionId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, movementType, movementDate])
  @@index([invoiceId])
  @@index([inventorySessionId])
  @@map("stock_movements")
}

model StockMovementLine {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  movementId   String   @map("movement_id")
  stockItemId  String   @map("stock_item_id")
  lotId        String?  @map("lot_id")
  serialIds    String[] @default([]) @map("serial_ids")
  locationId   String?  @map("location_id")
  qtyPlanned   Float    @default(0) @map("qty_planned")
  qtyActual    Float    @default(0) @map("qty_actual")
  unitCost     Float    @default(0) @map("unit_cost")
  totalCost    Float    @default(0) @map("total_cost")
  cmupBefore   Float?   @map("cmup_before")
  cmupAfter    Float?   @map("cmup_after")
  expiryDate   DateTime? @map("expiry_date") @db.Date
  /// Traçabilité saisie à la réception (avant création du lot)
  lotNumber    String?  @map("lot_number")
  manufactureDate DateTime? @map("manufacture_date") @db.Date
  serialNumbers String[] @default([]) @map("serial_numbers")

  movement  StockMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  stockItem StockItem          @relation(fields: [stockItemId], references: [id])
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@index([movementId])
  @@index([stockItemId, lotId])
  @@index([tenantId])
  @@map("stock_movement_lines")
}

enum StockTransferStatus {
  draft
  pending
  in_transit
  received
  completed
  cancelled
}

model StockTransfer {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  number             String
  status             StockTransferStatus @default(draft)
  sourceWarehouseId  String              @map("source_warehouse_id")
  destWarehouseId    String              @map("dest_warehouse_id")
  plannedDate        DateTime?           @map("planned_date") @db.Date
  shippedAt          DateTime?           @map("shipped_at")
  receivedAt         DateTime?           @map("received_at")
  movementOutId      String?             @map("movement_out_id")
  movementInId       String?             @map("movement_in_id")
  shippedBy          String?             @map("shipped_by")
  receivedBy         String?             @map("received_by")
  varianceReason     String?             @map("variance_reason")
  notes              String?
  createdBy          String              @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  sourceWarehouse Warehouse          @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse          @relation("TransferDestWarehouse", fields: [destWarehouseId], references: [id])
  lines           StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  transferId        String   @map("transfer_id")
  stockItemId       String   @map("stock_item_id")
  lotId             String?  @map("lot_id")
  lotNumber         String?  @map("lot_number")
  serialNumbers     String[] @default([]) @map("serial_numbers")
  sourceLocationId  String?  @map("source_location_id")
  destLocationId    String?  @map("dest_location_id")
  qtyPlanned        Float    @default(0) @map("qty_planned")
  qtyShipped        Float    @default(0) @map("qty_shipped")
  qtyReceived       Float?   @map("qty_received")
  unitCost          Float    @default(0) @map("unit_cost")
  varianceReason    String?  @map("variance_reason")

  transfer       StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem      StockItem          @relation(fields: [stockItemId], references: [id])
  lot            StockItemLot?      @relation(fields: [lotId], references: [id])
  sourceLocation WarehouseLocation? @relation("TransferLineSourceLocation", fields: [sourceLocationId], references: [id])
  destLocation   WarehouseLocation? @relation("TransferLineDestLocation", fields: [destLocationId], references: [id])

  @@index([transferId])
  @@index([tenantId])
  @@map("stock_transfer_lines")
}

enum InventorySessionType {
  total
  partial
}

enum InventorySessionStatus {
  draft
  counting
  recount
  analyzing
  validated
  closed
  cancelled
}

model InventorySession {
  id                      String                  @id @default(uuid())
  tenantId                String                  @map("tenant_id")
  number                  String
  type                    InventorySessionType
  status                  InventorySessionStatus  @default(draft)
  warehouseId             String                  @map("warehouse_id")
  categoryId              String?                 @map("category_id")
  plannedDate             DateTime?               @map("planned_date") @db.Date
  freezeMovements         Boolean                 @default(true) @map("freeze_movements")
  /// Écart qté déclenchant double comptage (RM-INV03). 0 = tout écart.
  varianceThresholdQty    Float                   @default(0) @map("variance_threshold_qty")
  /// Seuil d’écart significatif pour filtrage analyse (valeur)
  significantVarianceValue Float                  @default(0) @map("significant_variance_value")
  startedAt               DateTime?               @map("started_at")
  validatedAt             DateTime?               @map("validated_at")
  closedAt                DateTime?               @map("closed_at")
  validatedBy             String?                 @map("validated_by")
  closedBy                String?                 @map("closed_by")
  notes                   String?
  createdBy               String                  @map("created_by")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  lines     InventoryCountLine[]
  movements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([warehouseId, status])
  @@map("inventory_sessions")
}

model InventoryCountLine {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  sessionId       String   @map("session_id")
  stockItemId     String   @map("stock_item_id")
  lotId           String?  @map("lot_id")
  locationId      String?  @map("location_id")
  qtyTheoretical  Float    @default(0) @map("qty_theoretical")
  qtyCounted1     Float?   @map("qty_counted_1")
  qtyCounted2     Float?   @map("qty_counted_2")
  qtyFinal        Float?   @map("qty_final")
  unitCost        Float    @default(0) @map("unit_cost")
  varianceQty     Float?   @map("variance_qty")
  varianceValue   Float?   @map("variance_value")
  requiresRecount Boolean  @default(false) @map("requires_recount")
  countedBy1      String?  @map("counted_by_1")
  countedBy2      String?  @map("counted_by_2")
  notes           String?

  session   InventorySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stockItem StockItem          @relation(fields: [stockItemId], references: [id])
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
  @@map("inventory_count_lines")
}

enum StockAlertType {
  shortage
  safety
  overstock
  expiry
  dormant
}

enum StockAlertStatus {
  open
  acknowledged
  resolved
  dismissed
}

enum ReplenishmentProposalStatus {
  pending
  approved
  rejected
  cancelled
}

model StockAlert {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  alertType       StockAlertType   @map("alert_type")
  status          StockAlertStatus @default(open)
  severity        StockAlertLevel  @default(warning)
  stockItemId     String           @map("stock_item_id")
  warehouseId     String?          @map("warehouse_id")
  lotId           String?          @map("lot_id")
  qtyOnHand       Float            @default(0) @map("qty_on_hand")
  thresholdQty    Float?           @map("threshold_qty")
  /// Jours avant péremption (expiry) ou jours dormants (dormant) ou estimation rupture
  daysMetric      Float?           @map("days_metric")
  title           String
  message         String
  suggestion      String?
  suggestedQty    Float?           @map("suggested_qty")
  fingerprint     String
  acknowledgedAt  DateTime?        @map("acknowledged_at")
  acknowledgedBy  String?          @map("acknowledged_by")
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  stockItem StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])
  lot       StockItemLot?  @relation(fields: [lotId], references: [id])
  replenishment ReplenishmentProposal?

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, alertType])
  @@index([stockItemId])
  @@map("stock_alerts")
}

model ReplenishmentProposal {
  id              String                       @id @default(uuid())
  tenantId        String                       @map("tenant_id")
  number          String
  status          ReplenishmentProposalStatus  @default(pending)
  stockItemId     String                       @map("stock_item_id")
  warehouseId     String                       @map("warehouse_id")
  alertId         String?                      @unique @map("alert_id")
  qtyProposed     Float                        @map("qty_proposed")
  qtyConfigured   Float?                       @map("qty_configured")
  qtyAiSuggested  Float?                       @map("qty_ai_suggested")
  avgDailyUsage   Float?                       @map("avg_daily_usage")
  daysToStockout  Float?                       @map("days_to_stockout")
  reason          String?
  notes           String?
  decidedBy       String?                      @map("decided_by")
  decidedAt       DateTime?                    @map("decided_at")
  createdBy       String                       @map("created_by")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  stockItem StockItem  @relation(fields: [stockItemId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  alert     StockAlert? @relation(fields: [alertId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("replenishment_proposals")
}

/// Historique CMUP horodaté (RM-VAL02)
model StockCmupHistory {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  stockItemId   String   @map("stock_item_id")
  movementId    String?  @map("movement_id")
  movementLineId String? @map("movement_line_id")
  qtyBefore     Float    @map("qty_before")
  qtyAfter      Float    @map("qty_after")
  cmupBefore    Float    @map("cmup_before")
  cmupAfter     Float    @map("cmup_after")
  entryQty      Float    @map("entry_qty")
  entryUnitCost Float    @map("entry_unit_cost")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, stockItemId, recordedAt])
  @@map("stock_cmup_history")
}

model SyncDevice {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  deviceId   String    @map("device_id")
  deviceName String?   @map("device_name")
  lastPullAt DateTime? @map("last_pull_at")
  lastPushAt DateTime? @map("last_push_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, deviceId])
  @@map("sync_devices")
}

model SyncMutationLog {
  id         String             @id @default(uuid())
  tenantId   String             @map("tenant_id")
  userId     String             @map("user_id")
  deviceId   String             @map("device_id")
  batchId    String             @map("batch_id")
  mutationId String             @map("mutation_id")
  entityType String             @map("entity_type")
  operation  String
  entityId   String?            @map("entity_id")
  status     SyncMutationStatus
  errorCode  String?            @map("error_code")
  payload    Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([tenantId, deviceId, mutationId])
  @@index([tenantId, deviceId, batchId])
  @@map("sync_mutation_logs")
}
