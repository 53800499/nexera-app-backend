model RhRubriquePaie {
  id                    String              @id @default(uuid())
  paysCode              String              @map("pays_code")
  code                  String
  libelle               String
  typeRubrique          RhPayrollRubricType @map("type_rubrique")
  sensDefaut            RhRubricDirection   @default(GAIN) @map("sens_defaut")
  assujettiIts          Boolean             @default(true) @map("assujetti_its")
  assujettiCnss         Boolean             @default(true) @map("assujetti_cnss")
  assujettiVps          Boolean             @default(true) @map("assujetti_vps")
  formuleCalcul         String?             @map("formule_calcul")
  ordreAffichage        Int                 @default(100) @map("ordre_affichage")
  compteComptableCharge String?             @map("compte_comptable_charge")
  compteComptableTiers  String?             @map("compte_comptable_tiers")
  actif                 Boolean             @default(true)
