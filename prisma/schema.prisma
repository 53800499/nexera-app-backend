  nombreSucces           Int                  @default(0) @map("nombre_succes")
  nombreErreurs          Int                  @default(0) @map("nombre_erreurs")
  logErreurs             Json?                @map("log_erreurs")
  dateExecution          DateTime             @default(now()) @map("date_execution")
  createdAt              DateTime             @default(now()) @map("created_at")
