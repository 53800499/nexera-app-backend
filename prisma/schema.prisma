model RhZoneReglementaire {
  id        String   @id @default(uuid())
  code      String   @unique
  libelle   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pays      RhPays[]

  @@map("rh_zone_reglementaire")
}

model RhPays {
  codeIso2                   String              @id @map("code_iso2")
  codeIso3                   String              @unique @map("code_iso3")
  libelle                    String
  zoneReglementaireId        String?             @map("zone_reglementaire_id")
  deviseCode                 String              @map("devise_code")
  langueDefaut               String              @default("fr") @map("langue_defaut")
  organismeSecuSocialeLibelle String?            @map("organisme_secu_sociale_libelle")
  actif                      Boolean             @default(true)
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  zoneReglementaire          RhZoneReglementaire? @relation(fields: [zoneReglementaireId], references: [id])
  baremesIts                 RhBaremeIts[]
  tauxChargesSociales        RhTauxChargeSociale[]
  baremesAvantagesNature     RhBaremeAvantageNature[]
  parametres                 RhParametrePays[]
  joursFeries                RhJourFerie[]
  conventionsCollectives     RhConventionCollective[]
  typesAbsence               RhTypeAbsence[]
  rubriquesPaie              RhRubriquePaie[]
  etablissements             RhEtablissement[]
  declarations               RhDeclarationSocialeFiscale[]
  categoriesDepenseNdf       NdfCategorieDepense[]
  politiquesDepenseNdf       NdfPolitiqueDepense[]
  baremesKmNdf               NdfBaremeKilometrique[]
  baremesPerDiemNdf          NdfBaremePerDiem[]
  parametresNdf              NdfParametrePays[]

  @@map("rh_pays")
}

model RhBaremeIts {
  id                  String               @id @default(uuid())
  paysCode            String               @map("pays_code")
  codeImpot           String               @map("code_impot")
  libelle             String
  modeCalcul          RhItsCalculationMode @map("mode_calcul")
  periodiciteAssiette RhAssiettePeriodicity @default(MENSUELLE) @map("periodicite_assiette")
  dateDebutValidite   DateTime             @map("date_debut_validite")
  dateFinValidite     DateTime?            @map("date_fin_validite")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  pays                RhPays               @relation(fields: [paysCode], references: [codeIso2])
  tranches            RhBaremeItsTranche[]

  @@index([paysCode, dateDebutValidite])
  @@map("rh_bareme_its")
}

model RhBaremeItsTranche {
  id              String      @id @default(uuid())
  baremeItsId     String      @map("bareme_its_id")
  numeroTranche   Int         @map("numero_tranche")
  limiteInferieure Float      @map("limite_inferieure")
  limiteSuperieure Float?     @map("limite_superieure")
  taux            Float       @map("taux")
  montantDeductionFixe Float  @default(0) @map("montant_deduction_fixe")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  baremeIts       RhBaremeIts @relation(fields: [baremeItsId], references: [id], onDelete: Cascade)

  @@index([baremeItsId, numeroTranche])
  @@map("rh_bareme_its_tranche")
}

model RhTauxChargeSociale {
  id                  String              @id @default(uuid())
  paysCode            String              @map("pays_code")
  code                String
  libelle             String
  typeAssiette        RhAssietteType      @default(SALAIRE_BRUT) @map("type_assiette")
  partSalariale       RhSocialChargeShare @default(PATRONALE) @map("part_salariale")
  tauxSalarial        Float               @default(0) @map("taux_salarial")
  tauxPatronal        Float               @default(0) @map("taux_patronal")
  montantFixe         Float?              @map("montant_fixe")
  plafondMensuel      Float?              @map("plafond_mensuel")
  plancherMensuel     Float?              @map("plancher_mensuel")
  organismeCollecteur String?             @map("organisme_collecteur")
  dateDebutValidite   DateTime            @map("date_debut_validite")
  dateFinValidite     DateTime?           @map("date_fin_validite")
  actif               Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  pays                RhPays              @relation(fields: [paysCode], references: [codeIso2])

  @@index([paysCode, code, dateDebutValidite])
  @@map("rh_taux_charge_sociale")
}

model RhBaremeAvantageNature {
  id                String               @id @default(uuid())
  paysCode          String               @map("pays_code")
  typeAvantage      RhBenefitInKindType  @map("type_avantage")
  tauxPourcentage   Float?               @map("taux_pourcentage")
  montantFixe       Float?               @map("montant_fixe")
  description       String?
  conditionsJson    Json?                @map("conditions_json")
  dateDebutValidite DateTime             @map("date_debut_validite")
  dateFinValidite   DateTime?            @map("date_fin_validite")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  pays              RhPays               @relation(fields: [paysCode], references: [codeIso2])

  @@index([paysCode, typeAvantage])
  @@map("rh_bareme_avantage_nature")
}

model RhParametrePays {
  id                String                  @id @default(uuid())
  paysCode          String                  @map("pays_code")
  codeParametre     String                  @map("code_parametre")
  libelle           String
  typeValeur        RhCountryParamValueType @map("type_valeur")
  valeurTexte       String?                 @map("valeur_texte")
  valeurNumerique   Float?                  @map("valeur_numerique")
  valeurDate        DateTime?               @map("valeur_date")
  valeurJson        Json?                   @map("valeur_json")
  dateDebutValidite DateTime                @map("date_debut_validite")
  dateFinValidite   DateTime?               @map("date_fin_validite")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  pays              RhPays                  @relation(fields: [paysCode], references: [codeIso2])

  @@unique([paysCode, codeParametre, dateDebutValidite])
  @@map("rh_parametre_pays")
}

model RhJourFerie {
  id          String   @id @default(uuid())
  paysCode    String   @map("pays_code")
  dateJour    DateTime @map("date_jour")
  libelle     String
  estChomePaye Boolean @default(true) @map("est_chome_paye")
  annee       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pays        RhPays   @relation(fields: [paysCode], references: [codeIso2])

  @@unique([paysCode, dateJour])
  @@index([paysCode, annee])
  @@map("rh_jour_ferie")
}

