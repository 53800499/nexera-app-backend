  createdAt                           DateTime          @default(now()) @map("created_at")

  exerciceFiscal                      TaxExerciceFiscal @relation(fields: [taxExerciceFiscalId], references: [id], onDelete: Cascade)

  @@index([taxExerciceFiscalId])
  @@map("tax_solde_comptable_consulte")
}

// ----------------------------------------------------
// GROUPE K : CONTRÔLE FISCAL, SANCTIONS & CONTENTIEUX
// ----------------------------------------------------

model TaxPenalite {
  id                    String                 @id @default(uuid())
  taxEcheanceId         String?                @map("tax_echeance_id")
  typePenalite          TaxTypePenalite        @map("type_penalite")
  baseCalcul            Float                  @map("base_calcul")
  tauxApplique          Float                  @map("taux_applique")
  montantPenalite       Float                  @map("montant_penalite")
  sourceReglementaireId String?                @map("source_reglementaire_id")
  statut                TaxStatutPenalite      @default(CALCULEE) @map("statut")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  echeance              TaxEcheance?           @relation(fields: [taxEcheanceId], references: [id])
  sourceReglementaire   TaxSourceReglementaire? @relation(fields: [sourceReglementaireId], references: [id])

  @@index([taxEcheanceId, statut])
  @@map("tax_penalite")
}

model TaxControleFiscal {
  id                      String              @id @default(uuid())
  taxContribuableId       String              @map("tax_contribuable_id")
  typeControle            TaxTypeControle     @map("type_controle")
  dateAvisVerification   DateTime?           @map("date_avis_verification") @db.Date
  periodeControleeDebut   DateTime?           @map("periode_controlee_debut") @db.Date
  periodeControleeFin     DateTime?           @map("periode_controlee_fin") @db.Date
  serviceEnCharge         String?             @map("service_en_charge")
  statut                  TaxStatutControle   @default(EN_COURS) @map("statut")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  contribuable            TaxContribuable     @relation(fields: [taxContribuableId], references: [id], onDelete: Cascade)
  redressements           TaxRedressement[]

  @@index([taxContribuableId, statut])
  @@map("tax_controle_fiscal")
}

model TaxRedressement {
  id                         String                      @id @default(uuid())
  taxControleFiscalId        String                      @map("tax_controle_fiscal_id")
  taxTypeId                  String                      @map("tax_type_id")
  exerciceOuPeriodeConcerne  String                      @map("exercice_ou_periode_concerne")
  motif                      String                      @map("motif")
  montantDroitsReclames      Float                       @map("montant_droits_reclames")
  montantPenalitesReclamees  Float                       @default(0) @map("montant_penalites_reclamees")
  statut                     TaxStatutRedressement       @default(NOTIFIE) @map("statut")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  controleFiscal             TaxControleFiscal           @relation(fields: [taxControleFiscalId], references: [id], onDelete: Cascade)
  taxType                    TaxType                     @relation(fields: [taxTypeId], references: [id])
  reclamations               TaxReclamationContentieuse[]

  @@index([taxControleFiscalId])
  @@map("tax_redressement")
}

model TaxReclamationContentieuse {
  id                 String             @id @default(uuid())
  redressementId     String?            @map("redressement_id")
  taxContribuableId  String             @map("tax_contribuable_id")
  typeRecours        TaxTypeRecours     @map("type_recours")
  dateDepot          DateTime           @map("date_depot") @db.Date
  objet              String             @map("objet")
  statut             TaxStatutRecours   @default(EN_COURS) @map("statut")
  decisionDocumentUrl String?           @map("decision_document_url")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  redressement       TaxRedressement?   @relation(fields: [redressementId], references: [id])
  contribuable       TaxContribuable    @relation(fields: [taxContribuableId], references: [id], onDelete: Cascade)

  @@index([taxContribuableId, statut])
  @@map("tax_reclamation_contentieuse")
}

// ----------------------------------------------------
// GROUPE L : IMPORT / EXPORT & AUDIT
// ----------------------------------------------------

model TaxConnecteurEchange {
