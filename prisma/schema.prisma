  bulletinLignes        RhBulletinPaieLigne[]
  ecritureLignes        RhEcritureComptablePaieLigne[]

  @@unique([paysCode, code])
  @@map("rh_rubrique_paie")
}

model RhCyclePaie {
  id                  String                   @id @default(uuid())
  tenantId            String                   @map("tenant_id")
  etablissementId     String                   @map("etablissement_id")
  annee               Int
  mois                Int
  codeCycle           String                   @map("code_cycle")
  dateDebut           DateTime                 @map("date_debut")
  dateFin             DateTime                 @map("date_fin")
  datePaiementPrevue  DateTime                 @map("date_paiement_prevue")
  dateClotureSaisie   DateTime?                @map("date_cloture_saisie")
  dateCalcul          DateTime?                @map("date_calcul")
  dateValidationFinale DateTime?               @map("date_validation_finale")
  statut              RhPayrollCycleStatus     @default(OUVERT)
  cloturePar          String?                  @map("cloture_par")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  etablissement       RhEtablissement          @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  elementsVariables   RhElementVariable[]
  bulletinsPaie       RhBulletinPaie[]
  remunerationsExcep  RhRemunerationExceptionnelle[]
  declarations        RhDeclarationSocialeFiscale[]
  ecrituresComptables RhEcritureComptablePaie[]

  @@unique([tenantId, etablissementId, annee, mois])
  @@index([tenantId, statut])
  @@map("rh_cycle_paie")
}

model RhElementVariable {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  cyclePaieId       String         @map("cycle_paie_id")
  employeId         String         @map("employe_id")
  rubriquePaieId    String         @map("rubrique_paie_id")
  base              Float?
  taux              Float?
  montant           Float
  commentaire       String?
  validePar         String?        @map("valide_par")
  statutValidation  String         @default("VALIDE") @map("statut_validation")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  cyclePaie         RhCyclePaie    @relation(fields: [cyclePaieId], references: [id], onDelete: Cascade)
  employe           RhEmploye      @relation(fields: [employeId], references: [id], onDelete: Cascade)
  rubriquePaie      RhRubriquePaie @relation(fields: [rubriquePaieId], references: [id])

  @@index([tenantId, cyclePaieId, employeId])
  @@map("rh_element_variable")
}

model RhBulletinPaie {
