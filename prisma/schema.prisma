  dateDebut                   DateTime                    @map("date_debut")
  dateFinPrevue               DateTime?                   @map("date_fin_prevue")
  clauseExclusivite           Boolean                     @default(false) @map("clause_exclusivite")
  clauseNonConcurrence        Boolean                     @default(false) @map("clause_non_concurrence")
  salaireBaseMensuel          Float                       @map("salaire_base_mensuel")
  deviseCode                  String                      @default("XOF") @map("devise_code")
