model NdfCategorieDepense {
  id                         String                 @id @default(uuid())
  paysCode                   String?                @map("pays_code")
  code                       String                 @map("code")
  libelle                    String                 @map("libelle")
  compteSyscohadaDefaut      String?                @map("compte_syscohada_defaut")
  tvaRecuperableParDefaut    Boolean                @default(true) @map("tva_recuperable_par_defaut")
  tauxTvaParDefaut           Float?                 @map("taux_tva_par_defaut")
  justificatifObligatoire    Boolean                @default(true) @map("justificatif_obligatoire")
  actif                      Boolean                @default(true) @map("actif")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  isDeleted                  Boolean                @default(false) @map("is_deleted")

  pays                       RhPays?                @relation(fields: [paysCode], references: [codeIso2])
  politiques                 NdfPolitiqueDepense[]
  depenses                   NdfDepense[]

  @@unique([paysCode, code])
  @@index([paysCode, actif])
