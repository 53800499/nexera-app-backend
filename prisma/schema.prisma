  code                String                  @unique @map("code")
  libelle             String                  @map("libelle")
  sens                TaxConnecteurSens       @map("sens")
  format              TaxConnecteurFormat     @map("format")
  systemeTiersLibelle String?                 @map("systeme_tiers_libelle")
  actif               Boolean                 @default(true) @map("actif")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  isDeleted           Boolean                 @default(false) @map("is_deleted")

  mappings            TaxMappingChamp[]
  jobs                TaxJobImportExport[]

  @@map("tax_connecteur_echange")
}

model TaxMappingChamp {
  id                     String               @id @default(uuid())
  taxConnecteurEchangeId String               @map("tax_connecteur_echange_id")
