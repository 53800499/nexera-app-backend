  liasseFiscale      TaxLiasseFiscale @relation(fields: [taxLiasseFiscaleId], references: [id], onDelete: Cascade)

  @@index([taxLiasseFiscaleId])
  @@map("tax_liasse_fiscale_annexe")
}

// ----------------------------------------------------
// GROUPE H : CALENDRIER FISCAL & ÉCHÉANCIER
// ----------------------------------------------------

model TaxEcheance {
  id                String             @id @default(uuid())
  taxContribuableId String             @map("tax_contribuable_id")
  taxTypeId         String             @map("tax_type_id")
  objetLieType      String?            @map("objet_lie_type")
  objetLieId        String?            @map("objet_lie_id")
  dateLimite        DateTime           @map("date_limite") @db.Date
  montantEstime     Float?             @map("montant_estime")
  statut            TaxStatutEcheance  @default(A_VENIR) @map("statut")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  contribuable      TaxContribuable    @relation(fields: [taxContribuableId], references: [id], onDelete: Cascade)
  taxType           TaxType            @relation(fields: [taxTypeId], references: [id])
  alertes           TaxAlerteEcheance[]
  penalites         TaxPenalite[]

  @@index([taxContribuableId, dateLimite, statut])
  @@map("tax_echeance")
}

model TaxAlerteEcheance {
  id                        String          @id @default(uuid())
  taxEcheanceId             String          @map("tax_echeance_id")
  delaiJours                Int             @map("delai_jours") @db.SmallInt
  dateEnvoi                 DateTime?       @map("date_envoi")
  canal                     TaxCanalAlerte  @default(APPLICATION) @map("canal")
  destinataireUtilisateurId String          @map("destinataire_utilisateur_id")
  statut                    TaxStatutAlerte @default(PLANIFIEE) @map("statut")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  echeance                  TaxEcheance     @relation(fields: [taxEcheanceId], references: [id], onDelete: Cascade)

  @@index([taxEcheanceId, statut])
  @@map("tax_alerte_echeance")
}

// ----------------------------------------------------
// GROUPE I : TÉLÉDÉCLARATION & EDI
// ----------------------------------------------------

model TaxConnecteurDgi {
  id                            String            @id @default(uuid())
