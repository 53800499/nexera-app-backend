  employeId                         String                @map("employe_id")
  contratId                         String                @map("contrat_id")
  numeroBulletin                    String                @map("numero_bulletin")
  dateDebutPeriode                  DateTime              @map("date_debut_periode")
  dateFinPeriode                    DateTime              @map("date_fin_periode")
  datePaiement                      DateTime              @map("date_paiement")
  salaireBase                       Float                 @map("salaire_base")
  heuresNormales                    Float                 @default(173.33) @map("heures_normales")
  heuresSupplementairesTotal        Float                 @default(0) @map("heures_supplementaires_total")
  montantHeuresSup                  Float                 @default(0) @map("montant_heures_sup")
  montantPrimesIndemnitesBrutes     Float                 @default(0) @map("montant_primes_indemnites_brutes")
