  entityId   String          @map("entity_id")
  action     AuditAction
  changes    Json?
  metadata   Json?
  ipAddress  String?         @map("ip_address")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

enum SyncMutationStatus {
  applied
  conflict
  rejected
  duplicate
}

/// Module 2 — Gestion des Stocks (UC-S01)
enum StockValuationMethod {
  cmup
  fifo
  lifo
}

model Warehouse {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  code           String
  name           String
  address        Json?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  managerUserId  String?  @map("manager_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  locations            WarehouseLocation[]
  defaultForStockItems StockItem[]         @relation("StockItemDefaultWarehouse")
  stockLevels          StockLevel[]
  movements            StockMovement[]
  transfersAsSource    StockTransfer[]     @relation("TransferSourceWarehouse")
  transfersAsDest      StockTransfer[]     @relation("TransferDestWarehouse")
  inventorySessions    InventorySession[]
  alerts               StockAlert[]
  replenishments       ReplenishmentProposal[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  code        String
  zone        String?
  aisle       String?
  rack        String?
  bin         String?
  capacity    Float?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  defaultForStockItems StockItem[]         @relation("StockItemDefaultLocation")
  stockLevels          StockLevel[]
  movementLines        StockMovementLine[]
  serials              StockItemSerial[]
  transferLinesSource  StockTransferLine[] @relation("TransferLineSourceLocation")
  transferLinesDest    StockTransferLine[] @relation("TransferLineDestLocation")
  inventoryLines       InventoryCountLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("warehouse_locations")
}

model StockItem {
  id                  String                @id @default(uuid())
  tenantId            String                @map("tenant_id")
  commercialItemId    String                @map("commercial_item_id")
  trackLots           Boolean               @default(false) @map("track_lots")
  trackSerials        Boolean               @default(false) @map("track_serials")
  trackExpiry         Boolean               @default(false) @map("track_expiry")
  /** Seuil alerte péremption (jours) — §3.3 */
  expiryAlertDays     Int                   @default(30) @map("expiry_alert_days")
  valuationMethod     StockValuationMethod  @default(cmup) @map("valuation_method")
  storageUnit         String                @map("storage_unit")
  conversionFactor    Float                 @default(1) @map("conversion_factor")
  minStockQty         Float?                @map("min_stock_qty")
  safetyStockQty      Float?                @map("safety_stock_qty")
  maxStockQty         Float?                @map("max_stock_qty")
  reorderQty          Float?                @map("reorder_qty")
  defaultWarehouseId  String?               @map("default_warehouse_id")
  defaultLocationId   String?               @map("default_location_id")
  allowNegativeStock  Boolean               @default(false) @map("allow_negative_stock")
  currentCmup         Float                 @default(0) @map("current_cmup")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  commercialItem   CatalogItem         @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)
  defaultWarehouse Warehouse?          @relation("StockItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  defaultLocation  WarehouseLocation?  @relation("StockItemDefaultLocation", fields: [defaultLocationId], references: [id])
  lots             StockItemLot[]
  serials          StockItemSerial[]
  levels           StockLevel[]
  movementLines    StockMovementLine[]
  transferLines    StockTransferLine[]
  inventoryLines   InventoryCountLine[]
  alerts           StockAlert[]
  replenishments   ReplenishmentProposal[]
  cmupHistory      StockCmupHistory[]

  @@unique([commercialItemId])
  @@index([tenantId])
  @@index([tenantId, valuationMethod])
  @@map("stock_items")
}

enum StockMovementType {
  IN_SUPPLIER
  IN_RETURN
  IN_PRODUCTION
  IN_ADJUSTMENT
  IN_INITIAL
  OUT_SALE
  OUT_CONSUMPTION
  OUT_LOSS
  OUT_RETURN_SUPPLIER
  OUT_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum StockMovementStatus {
  draft
  validated
  cancelled
}

enum StockQualityStatus {
  accepted
  partial
  rejected
}

enum StockSerialStatus {
  in_stock
  sold
  transferred
  scrapped
}

enum StockAlertLevel {
  ok
  warning
  critical
}

model StockItemLot {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  stockItemId      String   @map("stock_item_id")
  lotNumber        String   @map("lot_number")
  manufactureDate  DateTime? @map("manufacture_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  receivedDate     DateTime @default(now()) @map("received_date") @db.Date
  supplierId       String?  @map("supplier_id")
  initialQty       Float    @default(0) @map("initial_qty")
  remainingQty     Float    @default(0) @map("remaining_qty")
  unitCost         Float    @default(0) @map("unit_cost")
  isQuarantine     Boolean  @default(false) @map("is_quarantine")
  quarantineReason String?  @map("quarantine_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  stockItem     StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  levels        StockLevel[]
  movementLines StockMovementLine[]
  serials       StockItemSerial[]
  transferLines StockTransferLine[]
  inventoryLines InventoryCountLine[]
  alerts         StockAlert[]

  @@unique([stockItemId, lotNumber])
  @@index([tenantId])
  @@index([expiryDate])
  @@map("stock_item_lots")
}

model StockItemSerial {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  stockItemId    String            @map("stock_item_id")
  serialNumber   String            @map("serial_number")
  lotId          String?           @map("lot_id")
  status         StockSerialStatus @default(in_stock)
  warehouseId    String?           @map("warehouse_id")
  locationId     String?           @map("location_id")
  receivedDate   DateTime          @default(now()) @map("received_date") @db.Date
  soldInvoiceId  String?           @map("sold_invoice_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  stockItem StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@unique([stockItemId, serialNumber])
  @@index([tenantId])
  @@map("stock_item_serials")
}

model StockLevel {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  stockItemId   String          @map("stock_item_id")
  warehouseId   String          @map("warehouse_id")
  locationId    String?         @map("location_id")
  lotId         String?         @map("lot_id")
  qtyOnHand     Float           @default(0) @map("qty_on_hand")
  qtyReserved   Float           @default(0) @map("qty_reserved")
  qtyAvailable  Float           @default(0) @map("qty_available")
  qtyIncoming   Float           @default(0) @map("qty_incoming")
  unitValue     Float           @default(0) @map("unit_value")
  totalValue    Float           @default(0) @map("total_value")
  alertLevel    StockAlertLevel @default(ok) @map("alert_level")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  stockItem StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])

  @@index([tenantId, stockItemId, warehouseId])
  @@index([tenantId, alertLevel])
  @@index([stockItemId, lotId])
  @@map("stock_levels")
}

model StockMovement {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  number             String
  movementType       StockMovementType   @map("movement_type")
  status             StockMovementStatus @default(draft)
  warehouseId        String              @map("warehouse_id")
  movementDate       DateTime            @default(now()) @map("movement_date") @db.Date
  reference          String?
  invoiceId          String?             @map("invoice_id")
  transferId         String?             @map("transfer_id")
  inventorySessionId String?             @map("inventory_session_id")
  supplierId         String?             @map("supplier_id")
  qualityStatus      StockQualityStatus? @map("quality_status")
  reason             String?
  approvedBy         String?             @map("approved_by")
  approvedAt         DateTime?           @map("approved_at")
  notes              String?
  createdBy          String              @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     StockMovementLine[]
  inventorySession InventorySession? @relation(fields: [inventorySessionId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, movementType, movementDate])
  @@index([invoiceId])
  @@index([inventorySessionId])
  @@map("stock_movements")
}

model StockMovementLine {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  movementId   String   @map("movement_id")
  stockItemId  String   @map("stock_item_id")
  lotId        String?  @map("lot_id")
  serialIds    String[] @default([]) @map("serial_ids")
  locationId   String?  @map("location_id")
  qtyPlanned   Float    @default(0) @map("qty_planned")
  qtyActual    Float    @default(0) @map("qty_actual")
  unitCost     Float    @default(0) @map("unit_cost")
  totalCost    Float    @default(0) @map("total_cost")
  cmupBefore   Float?   @map("cmup_before")
  cmupAfter    Float?   @map("cmup_after")
  expiryDate   DateTime? @map("expiry_date") @db.Date
  /// Traçabilité saisie à la réception (avant création du lot)
  lotNumber    String?  @map("lot_number")
  manufactureDate DateTime? @map("manufacture_date") @db.Date
  serialNumbers String[] @default([]) @map("serial_numbers")

  movement  StockMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  stockItem StockItem          @relation(fields: [stockItemId], references: [id])
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@index([movementId])
  @@index([stockItemId, lotId])
  @@index([tenantId])
  @@map("stock_movement_lines")
}

enum StockTransferStatus {
  draft
  pending
  in_transit
  received
  completed
  cancelled
}

model StockTransfer {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  number             String
  status             StockTransferStatus @default(draft)
  sourceWarehouseId  String              @map("source_warehouse_id")
  destWarehouseId    String              @map("dest_warehouse_id")
  plannedDate        DateTime?           @map("planned_date") @db.Date
  shippedAt          DateTime?           @map("shipped_at")
  receivedAt         DateTime?           @map("received_at")
  movementOutId      String?             @map("movement_out_id")
  movementInId       String?             @map("movement_in_id")
  shippedBy          String?             @map("shipped_by")
  receivedBy         String?             @map("received_by")
  varianceReason     String?             @map("variance_reason")
  notes              String?
  createdBy          String              @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  sourceWarehouse Warehouse          @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse          @relation("TransferDestWarehouse", fields: [destWarehouseId], references: [id])
  lines           StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  transferId        String   @map("transfer_id")
  stockItemId       String   @map("stock_item_id")
  lotId             String?  @map("lot_id")
  lotNumber         String?  @map("lot_number")
  serialNumbers     String[] @default([]) @map("serial_numbers")
  sourceLocationId  String?  @map("source_location_id")
  destLocationId    String?  @map("dest_location_id")
  qtyPlanned        Float    @default(0) @map("qty_planned")
  qtyShipped        Float    @default(0) @map("qty_shipped")
  qtyReceived       Float?   @map("qty_received")
  unitCost          Float    @default(0) @map("unit_cost")
  varianceReason    String?  @map("variance_reason")

  transfer       StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem      StockItem          @relation(fields: [stockItemId], references: [id])
  lot            StockItemLot?      @relation(fields: [lotId], references: [id])
  sourceLocation WarehouseLocation? @relation("TransferLineSourceLocation", fields: [sourceLocationId], references: [id])
  destLocation   WarehouseLocation? @relation("TransferLineDestLocation", fields: [destLocationId], references: [id])

  @@index([transferId])
  @@index([tenantId])
  @@map("stock_transfer_lines")
}

enum InventorySessionType {
  total
  partial
}

enum InventorySessionStatus {
  draft
  counting
  recount
  analyzing
  validated
  closed
  cancelled
}

model InventorySession {
  id                      String                  @id @default(uuid())
  tenantId                String                  @map("tenant_id")
  number                  String
  type                    InventorySessionType
  status                  InventorySessionStatus  @default(draft)
  warehouseId             String                  @map("warehouse_id")
  categoryId              String?                 @map("category_id")
  plannedDate             DateTime?               @map("planned_date") @db.Date
  freezeMovements         Boolean                 @default(true) @map("freeze_movements")
  /// Écart qté déclenchant double comptage (RM-INV03). 0 = tout écart.
  varianceThresholdQty    Float                   @default(0) @map("variance_threshold_qty")
  /// Seuil d’écart significatif pour filtrage analyse (valeur)
  significantVarianceValue Float                  @default(0) @map("significant_variance_value")
  startedAt               DateTime?               @map("started_at")
  validatedAt             DateTime?               @map("validated_at")
  closedAt                DateTime?               @map("closed_at")
  validatedBy             String?                 @map("validated_by")
  closedBy                String?                 @map("closed_by")
  notes                   String?
  createdBy               String                  @map("created_by")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  lines     InventoryCountLine[]
  movements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([warehouseId, status])
  @@map("inventory_sessions")
}

model InventoryCountLine {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  sessionId       String   @map("session_id")
  stockItemId     String   @map("stock_item_id")
  lotId           String?  @map("lot_id")
  locationId      String?  @map("location_id")
  qtyTheoretical  Float    @default(0) @map("qty_theoretical")
  qtyCounted1     Float?   @map("qty_counted_1")
  qtyCounted2     Float?   @map("qty_counted_2")
  qtyFinal        Float?   @map("qty_final")
  unitCost        Float    @default(0) @map("unit_cost")
  varianceQty     Float?   @map("variance_qty")
  varianceValue   Float?   @map("variance_value")
  requiresRecount Boolean  @default(false) @map("requires_recount")
  countedBy1      String?  @map("counted_by_1")
  countedBy2      String?  @map("counted_by_2")
  notes           String?

  session   InventorySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stockItem StockItem          @relation(fields: [stockItemId], references: [id])
  lot       StockItemLot?      @relation(fields: [lotId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
  @@map("inventory_count_lines")
}

enum StockAlertType {
  shortage
  safety
  overstock
  expiry
  dormant
}

enum StockAlertStatus {
  open
  acknowledged
  resolved
  dismissed
}

enum ReplenishmentProposalStatus {
  pending
  approved
  rejected
  cancelled
}

model StockAlert {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  alertType       StockAlertType   @map("alert_type")
  status          StockAlertStatus @default(open)
  severity        StockAlertLevel  @default(warning)
  stockItemId     String           @map("stock_item_id")
  warehouseId     String?          @map("warehouse_id")
  lotId           String?          @map("lot_id")
  qtyOnHand       Float            @default(0) @map("qty_on_hand")
  thresholdQty    Float?           @map("threshold_qty")
  /// Jours avant péremption (expiry) ou jours dormants (dormant) ou estimation rupture
  daysMetric      Float?           @map("days_metric")
  title           String
  message         String
  suggestion      String?
  suggestedQty    Float?           @map("suggested_qty")
  fingerprint     String
  acknowledgedAt  DateTime?        @map("acknowledged_at")
  acknowledgedBy  String?          @map("acknowledged_by")
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  stockItem StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])
  lot       StockItemLot?  @relation(fields: [lotId], references: [id])
  replenishment ReplenishmentProposal?

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, alertType])
  @@index([stockItemId])
  @@map("stock_alerts")
}

model ReplenishmentProposal {
  id              String                       @id @default(uuid())
  tenantId        String                       @map("tenant_id")
  number          String
  status          ReplenishmentProposalStatus  @default(pending)
  stockItemId     String                       @map("stock_item_id")
  warehouseId     String                       @map("warehouse_id")
  alertId         String?                      @unique @map("alert_id")
  qtyProposed     Float                        @map("qty_proposed")
  qtyConfigured   Float?                       @map("qty_configured")
  qtyAiSuggested  Float?                       @map("qty_ai_suggested")
  avgDailyUsage   Float?                       @map("avg_daily_usage")
  daysToStockout  Float?                       @map("days_to_stockout")
  reason          String?
  notes           String?
  decidedBy       String?                      @map("decided_by")
  decidedAt       DateTime?                    @map("decided_at")
  createdBy       String                       @map("created_by")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  stockItem StockItem  @relation(fields: [stockItemId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  alert     StockAlert? @relation(fields: [alertId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("replenishment_proposals")
}

/// Historique CMUP horodaté (RM-VAL02)
model StockCmupHistory {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
