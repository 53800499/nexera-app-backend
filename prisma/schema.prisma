}

model RhContratRupture {
  id                          String             @id @default(uuid())
  contratId                   String             @unique @map("contrat_id")
  typeRupture                 RhTerminationType  @map("type_rupture")
  dateNotification            DateTime           @map("date_notification")
  dateEffet                   DateTime           @map("date_effet")
  dureePreavisJours           Int                @default(0) @map("duree_preavis_jours")
  dispensePreavis             Boolean            @default(false) @map("dispense_preavis")
  montantIndemnitePreavis     Float              @default(0) @map("montant_indemnite_preavis")
  montantIndemniteLicenciement Float             @default(0) @map("montant_indemnite_licenciement")
  montantIndemniteCongesPayes Float              @default(0) @map("montant_indemnite_conges_payes")
  montantDommagesInterets     Float              @default(0) @map("montant_dommages_interets")
  motifDetaille               String?            @map("motif_detaille")
