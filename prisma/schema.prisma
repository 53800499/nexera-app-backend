  endpointUrl                   String?           @map("endpoint_url")
  referenceIdentifiantsSecurises String?          @map("reference_identifiants_securises")
  actif                         Boolean           @default(true) @map("actif")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")

  pays                          TaxPays           @relation(fields: [paysCode], references: [codeIso2])
  soumissions                   TaxSoumissionEdi[]

  @@map("tax_connecteur_dgi")
}

model TaxSoumissionEdi {
  id                       String           @id @default(uuid())
  taxConnecteurDgiId       String           @map("tax_connecteur_dgi_id")
  objetDeclareType         String           @map("objet_declare_type")
  objetDeclareId           String           @map("objet_declare_id")
  dateSoumission           DateTime         @default(now()) @map("date_soumission")
