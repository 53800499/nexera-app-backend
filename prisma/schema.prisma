  totalSalaireBrut                  Float                 @map("total_salaire_brut")
  totalAssietteCnss                 Float                 @map("total_assiette_cnss")
  totalAssietteIts                  Float                 @map("total_assiette_its")
  totalAssietteVps                  Float                 @map("total_assiette_vps")
  montantCnssSalariale              Float                 @default(0) @map("montant_cnss_salariale")
  montantImpotSalaire               Float                 @default(0) @map("montant_impot_salaire")
  montantAutresRetenuesSalariales   Float                 @default(0) @map("montant_autres_retenues_salariales")
  totalRetenuesSalariales           Float                 @default(0) @map("total_retenues_salariales")
  montantCnssPatronale              Float                 @default(0) @map("montant_cnss_patronale")
  montantVpsPatronale               Float                 @default(0) @map("montant_vps_patronale")
  montantChargesPatronalesDiverses  Float                 @default(0) @map("montant_charges_patronales_diverses")
  totalChargesPatronales            Float                 @default(0) @map("total_charges_patronales")
  netImposable                      Float                 @map("net_imposable")
  netAPayer                         Float                 @map("net_a_payer")
  netApresRetenues                  Float                 @map("net_apres_retenues")
  cumulBrutAnnee                    Float                 @default(0) @map("cumul_brut_annee")
  cumulItsAnnee                     Float                 @default(0) @map("cumul_its_annee")
  cumulCnssSalarialeAnnee           Float                 @default(0) @map("cumul_cnss_salariale_annee")
  cumulNetPayeAnnee                 Float                 @default(0) @map("cumul_net_paye_annee")
  modePaiement                      RhPaymentMethod       @default(VIREMENT_BANCAIRE) @map("mode_paiement")
  statut                            RhPayslipStatus       @default(CALCULE)
  dateEdition                       DateTime              @default(now()) @map("date_edition")
  hashSignatureNumerique            String?               @map("hash_signature_numerique")
  fichierPdfUrl                     String?               @map("fichier_pdf_url")
  createdAt                         DateTime              @default(now()) @map("created_at")
  updatedAt                         DateTime              @updatedAt @map("updated_at")

