  tailleOctets        Int?      @map("taille_octets")
  typeMime            String?   @map("type_mime")
  dateEmission        DateTime? @map("date_emission")
  dateExpiration      DateTime? @map("date_expiration")
  statutVerification  String    @default("EN_ATTENTE") @map("statut_verification")
  verifiePar          String?   @map("verifie_par")
  dateVerification    DateTime? @map("date_verification")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  employe             RhEmploye @relation(fields: [employeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeId])
