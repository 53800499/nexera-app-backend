  @@index([tenantId, employeRefId, statut])
  @@map("ndf_avance_frais")
}

model NdfRapportFrais {
  id                         String           @id @default(uuid())
  tenantId                   String           @map("tenant_id")
  employeRefId               String           @map("employe_ref_id")
  missionId                  String?          @map("mission_id")
  numeroRapport              String           @unique @map("numero_rapport")
  objet                      String           @map("objet")
  periodeDebut               DateTime         @map("periode_debut")
  periodeFin                 DateTime         @map("periode_fin")
  montantTotal               Float            @default(0) @map("montant_total")
  montantTvaRecuperableTotal Float            @default(0) @map("montant_tva_recuperable_total")
  avanceFraisId              String?          @map("avance_frais_id")
  statut                     NdfRapportStatut @default(BROUILLON) @map("statut")
  scoreRisqueIa              Float?           @map("score_risque_ia")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  isDeleted                  Boolean          @default(false) @map("is_deleted")

