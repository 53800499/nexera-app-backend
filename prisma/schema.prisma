  rupture                     RhContratRupture?
  bulletinsPaie               RhBulletinPaie[]

  @@unique([tenantId, numeroContrat])
  @@index([tenantId, employeId, statut])
  @@map("rh_contrat")
}

model RhContratPeriodeEssai {
  id                      String            @id @default(uuid())
  contratId               String            @unique @map("contrat_id")
  dureeJoursOuvres        Int               @map("duree_jours_ouvres")
  dateDebut               DateTime          @map("date_debut")
  dateFin                 DateTime          @map("date_fin")
  estRenouvele            Boolean           @default(false) @map("est_renouvele")
  dateDebutRenouvellement DateTime?         @map("date_debut_renouvellement")
  dateFinRenouvellement   DateTime?         @map("date_fin_renouvellement")
