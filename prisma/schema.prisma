  posteId                     String?                     @map("poste_id")
  categorieProfessionnelleId  String?                     @map("categorie_professionnelle_id")
  conventionCollectiveId      String?                     @map("convention_collective_id")
  nombreRenouvellements       Int                         @default(0) @map("nombre_renouvellements")
  statutVisaMinistereTravail  String?                     @map("statut_visa_ministere_travail")
  dateVisaMinistere           DateTime?                   @map("date_visa_ministere")
  numeroVisaMinistere         String?                     @map("numero_visa_ministere")
  fichierContratUrl           String?                     @map("fichier_contrat_url")
  notes                       String?
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")

  employe                     RhEmploye                   @relation(fields: [employeId], references: [id], onDelete: Cascade)
  etablissement               RhEtablissement             @relation(fields: [etablissementId], references: [id])
  poste                       RhPoste?                    @relation(fields: [posteId], references: [id])
  categorieProfessionnelle    RhCategorieProfessionnelle? @relation(fields: [categorieProfessionnelleId], references: [id])
